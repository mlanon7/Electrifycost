---
// Reserved affiliate-product slot. Renders nothing user-visible unless
// PUBLIC_AFFILIATES_ENABLED is 'true'. Only the three kinds actually
// placed on calculator pages — re-widen the union if heat_pump or
// load_management affiliate slots are added later. When enabled, the
// actual product cards / outbound links live alongside this component
// (separate PR — blocked on Amazon Associates approval).
//
// Layout reserves a CLS-safe min-height so flipping the flag on later
// doesn't shift the page.
const { kind } = Astro.props as { kind: 'ev_charger' | 'induction' | 'hpwh' };
const enabled = import.meta.env.PUBLIC_AFFILIATES_ENABLED === 'true';
---
{enabled && (
  <section class="container-wide py-8" data-affiliate-kind={kind}>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-600">Recommended products</h2>
    <p class="mt-1 text-xs text-ink-600">Curated picks for the {kind.replace('_', ' ')} category.</p>
    <!-- Product card list injected separately when wired -->
  </section>
)}
