---
import { GUIDE_META } from '@/lib/guide-relationships';

interface Props {
  slug: string;
}
const { slug } = Astro.props as Props;
const meta = GUIDE_META[slug];
const siblings = meta?.siblings?.map(s => GUIDE_META[s]).filter(Boolean) ?? [];
---
{meta && (
  <section class="container-tight border-t border-ink-100 py-10 not-prose">
    <h2 class="text-2xl font-semibold text-ink-900">Related guides</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {siblings.map(s => (
        <li>
          <a href={`/guides/${s.slug}/`} class="card flex h-full flex-col p-4 no-underline hover:-translate-y-0.5 hover:shadow-md transition">
            <p class="eyebrow">Guide</p>
            <h3 class="mt-1 text-base font-semibold text-ink-900">{s.title}</h3>
            <p class="mt-1 text-xs text-ink-600">Read the {s.title.toLowerCase()} guide →</p>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={meta.calculatorHref} class="btn-primary">Open the {meta.title.toLowerCase()} calculator →</a>
    </div>
  </section>
)}
