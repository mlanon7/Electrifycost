---
import '@/styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CookieBanner from './CookieBanner.astro';
import { siteLastReviewed } from '@/lib/data';

interface BreadcrumbCrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  active?: string;
  schemaJsonLd?: object | object[];
  ogImage?: string;
  breadcrumbs?: BreadcrumbCrumb[];
  lastReviewed?: string;
  /** Emit `noindex, follow`. Use for pages that are useful to visitors but are
   *  near-duplicates of a canonical page (e.g. the city pages, which measured
   *  0-5% unique against their siblings). `follow` keeps internal link equity
   *  flowing. `scripts/build-sitemap.cjs` skips any page that sets this. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  active,
  schemaJsonLd,
  ogImage,
  breadcrumbs,
  lastReviewed,
  noindex,
} = Astro.props as Props;

// Default to the site-wide freshness stamp when a page doesn't pass its own.
const reviewedAt = lastReviewed || siteLastReviewed;

const siteOrigin = (Astro.site ?? new URL('https://electrifycost.com/')).toString().replace(/\/$/, '');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://electrifycost.com').toString();

// Default OG image. Lives at /og-default.png; until that asset is shipped,
// we still emit the meta tag so social platforms have a stable target.
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`)
  : `${siteOrigin}/og-default.png`;

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 1
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: b.href.startsWith('http') ? b.href : `${siteOrigin}${b.href}`,
      })),
    }
  : null;

const baseSchemas = schemaJsonLd ? (Array.isArray(schemaJsonLd) ? schemaJsonLd : [schemaJsonLd]) : [];
const schemas = breadcrumbSchema ? [...baseSchemas, breadcrumbSchema] : baseSchemas;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Embed mode: when a calculator is opened inside the Project Simulator's
        popup (?embed=1), strip the site chrome so the iframe shows just the
        calculator. With ?zip=NNNNN, also pre-fill the calculator's ZIP input so
        its state + prices match the simulator's ZIP. Runs before paint to avoid
        a flash of the header/footer. */}
    <script is:inline>
      (function () {
        var p = new URLSearchParams(location.search);
        if (p.get('embed') !== '1') return;
        document.documentElement.classList.add('ec-embed');
        var zip = (p.get('zip') || '').replace(/\D/g, '').slice(0, 5);
        if (zip.length !== 5) return;
        // The calculator is a React island that hydrates after load. Set its ZIP
        // input via the native setter + an input event (so React's onChange fires
        // and it derives the state), retrying until the value sticks past hydration.
        var tries = 0, ok = 0;
        function findZip() {
          return document.querySelector('#zip, input[autocomplete="postal-code"], input[name="zip"], input[inputmode="numeric"][maxlength="5"]');
        }
        function setVal(el) {
          var d = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value');
          d.set.call(el, zip);
          el.dispatchEvent(new Event('input', { bubbles: true }));
          el.dispatchEvent(new Event('change', { bubbles: true }));
        }
        var iv = setInterval(function () {
          tries++;
          var el = findZip();
          if (el) {
            if (el.value === zip) { ok++; if (ok >= 2) { clearInterval(iv); return; } }
            else { ok = 0; setVal(el); }
          }
          if (tries > 60) clearInterval(iv);
        }, 80);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {reviewedAt && <meta name="article:modified_time" content={reviewedAt} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ElectrifyCost" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="theme-color" content="#059669" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Warm up the TLS connections for the two async analytics origins so the
        DNS+TLS handshake overlaps with page render rather than blocking the
        deferred fetch. Both scripts still load async (non-render-blocking). */}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://analytics.ahrefs.com" crossorigin />
    {/* Inter + Source Serif 4 are self-hosted via @fontsource and imported in
        src/styles/global.css. No more third-party fetch in <head>. */}
    {schemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {/* Google Analytics 4 with Consent Mode v2.
        Defaults are 'denied' for all storage so the page loads compliant with
        EU GDPR + California CCPA from the first byte. The CookieBanner below
        updates consent to 'granted' if the user accepts. The Measurement ID
        is intentionally public (it's in the request URL anyway) so hard-
        coding is fine for a single-property site. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      // Re-apply any prior decision so we don't show the banner again.
      try {
        var stored = localStorage.getItem('ec_consent_v1');
        if (stored === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted'
          });
        }
      } catch (e) { /* localStorage unavailable; fall back to default denied */ }
      gtag('js', new Date());
      gtag('config', 'G-5CMBX2RBY4', { anonymize_ip: true });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5CMBX2RBY4"></script>

    {/* Ahrefs Web Analytics: cookieless, no consent gating needed. */}
    <script async src="https://analytics.ahrefs.com/analytics.js" data-key="ZNPKoM1LyX3ZL5OsiluGxw"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header active={active} />
    {breadcrumbs && breadcrumbs.length > 1 && (
      <nav aria-label="Breadcrumb" class="border-b border-ink-100 bg-ink-50/60 print:hidden">
        <div class="container-wide flex flex-wrap items-center justify-between gap-2 py-2 text-xs text-ink-600">
          <ol class="flex flex-wrap items-center gap-1.5">
            {breadcrumbs.map((b, i) => {
              const isLast = i === breadcrumbs.length - 1;
              return (
                <li class="flex items-center gap-1.5">
                  {i > 0 && <span aria-hidden="true" class="text-ink-400">›</span>}
                  {isLast ? (
                    <span class="font-medium text-ink-800" aria-current="page">{b.name}</span>
                  ) : (
                    <a href={b.href} class="text-ink-600 hover:text-brand-700 hover:underline underline-offset-2">{b.name}</a>
                  )}
                </li>
              );
            })}
          </ol>
          {reviewedAt && (
            <p class="hidden tabular-nums text-ink-600 sm:block">
              <span class="text-ink-600">Reviewed</span>{' '}
              <time datetime={reviewedAt}>{reviewedAt}</time>
            </p>
          )}
        </div>
      </nav>
    )}
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
