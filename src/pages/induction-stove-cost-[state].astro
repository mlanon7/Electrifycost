---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import InductionCalculator from '@/components/InductionCalculator';
import {
  ALL_STATES,
  findStateEnergy,
  findStateLabor,
  findClimate,
  rebatePrograms,
} from '@/lib/data';
import { fmtUSD } from '@/lib/format';

export async function getStaticPaths() {
  return ALL_STATES.map(s => ({ params: { state: s.code.toLowerCase() } }));
}

const { state: stateParam } = Astro.params as { state: string };
const stateCode = (stateParam ?? '').toUpperCase();
// getStaticPaths enumerates every valid state, so meta is always defined at
// build time. The non-null assertion is safe here.
const meta = ALL_STATES.find(s => s.code === stateCode)!;
const stateName = meta.name;
const energy = findStateEnergy(stateCode);
const labor  = findStateLabor(stateCode);
const climate = findClimate(stateCode);

const stateRebates = rebatePrograms.filter(
  r => (r.module === 'induction' || r.module === '') &&
       (r.state === stateCode || r.scope === 'federal')
);

const isCold = climate?.heat_pump_class === 'coldclimate';
const electricityCents = energy?.electricity_cents_per_kwh ?? 0;
const gasPrice = energy?.natural_gas_dollars_per_therm ?? 0;
const oilPrice = energy?.heating_oil_dollars_per_gallon ?? 0;
const propanePrice = energy?.propane_dollars_per_gallon ?? 0;

const description = `Induction range, cooktop & 240V circuit installed cost in ${stateName}: state electrician labor ${labor?.electrician_multiplier?.toFixed(2) ?? 'n/a'}×, ${stateRebates.length} rebate programs (incl. DOE HEEHRA).`;

const faq = [
  {
    q: `How much does an induction range install cost in ${stateName}?`,
    a: `In ${stateName}, a basic 30-inch induction range install runs ${fmtUSD(1500 * (labor?.electrician_multiplier ?? 1))}–${fmtUSD(3500 * (labor?.electrician_multiplier ?? 1))}. A new 240V circuit adds $400 to $1,300 if needed (most kitchens with a gas range do not have one). Capping the existing gas line costs $150 to $450. Premium ranges (Bosch 800, Café, Wolf, Miele) add $1,000 to $3,000.`,
  },
  {
    q: `What are the operating-cost savings vs. gas in ${stateName}?`,
    a: 'Induction-vs-gas operating cost is roughly neutral at typical cooking volumes — the annual delta is typically within $25 per year. The real value is indoor air quality (no combustion byproducts), faster boil times, easier cleanup, and removing a combustion appliance from the kitchen.',
  },
  {
    q: `What rebates apply to induction stoves in ${stateName}?`,
    a: `The federal 25C credit does NOT cover stoves. DOE HEEHRA provides up to $840 for electric stoves, cooktops, or ranges in income-qualified households, administered state by state. The rebate table above shows ${stateRebates.length} applicable programs for ${stateName}.`,
  },
  {
    q: `Will existing cookware work with induction?`,
    a: 'Induction works only with magnetic cookware (cast iron, magnetic stainless steel). The magnet test: if a fridge magnet sticks to the bottom of a pan, it works. Aluminum, copper, and most non-magnetic stainless steel do not. A starter cookware allowance of $75 to $450 covers basic pieces — many homes already have enough cast-iron cookware to skip this entirely.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Induction Stove Cost Calculator — ${stateName}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title={`Induction Stove Cost in ${stateName}`}
  description={description}
  active="/induction-stove-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Induction by state', href: '/induction-stove-cost-by-state/' },
    { name: stateName, href: `/induction-stove-cost-${stateCode.toLowerCase()}/` },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{stateName}</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Induction Stove Cost in {stateName}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 md:text-base">
      Estimate the installed cost of an induction range, drop-in cooktop, or portable unit in {stateName}. Calibrated to local electrician labor ({labor?.electrician_multiplier?.toFixed(2) ?? '—'}× the U.S. average) for 240V circuit work and gas-line capping.
    </p>
    <p class="mt-3 max-w-2xl text-xs text-ink-600">
      <strong>Planning range, not a contractor quote.</strong> Verify state and utility programs with the linked administrator before claiming — caps, eligibility, and timelines change.
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Electrician labor</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{labor?.electrician_multiplier?.toFixed(2) ?? '—'}×</div>
        <div class="text-xs text-ink-600">vs. U.S. average (BLS)</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Electricity</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{electricityCents.toFixed(1)}¢/kWh</div>
        <div class="text-xs text-ink-600">EIA retail average</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Natural gas</div>
        <div class="mt-1 text-base font-semibold text-ink-900">${gasPrice.toFixed(2)}/therm</div>
        <div class="text-xs text-ink-600">induction-vs-gas context</div>
      </div>
    </div>
  </section>

  <section class="container-wide pb-10">
    <InductionCalculator client:load initialState={stateCode} />
  </section>

  <section class="container-wide py-10">
    <h2 class="text-xl font-semibold text-ink-900">Induction-related rebates &amp; credits in {stateName}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
          <tr>
            <th class="py-2 pr-3">Program</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Amount</th>
            <th class="py-2 pr-3">Expires</th>
          </tr>
        </thead>
        <tbody>
          {stateRebates.map(p => (
            <tr class="border-b border-ink-100 align-top">
              <td class="py-2 pr-3">
                <div class="font-medium text-ink-900">
                  {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                </div>
                {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.scope === 'federal' ? 'Federal' : p.scope === 'state' ? 'State' : 'Utility'} · {p.incentive_type === 'tax_credit' ? 'Credit' : 'Rebate'}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-900">
                {p.percent > 0 ? `${p.percent}% up to $${p.cap.toLocaleString()}` :
                  p.amount_low === p.amount_high ? `$${p.amount_high.toLocaleString()}` :
                  `$${p.amount_low.toLocaleString()}–$${p.amount_high.toLocaleString()}`}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.expiration_date || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Induction stove cost by state</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {ALL_STATES.map(s => (
        <li><a href={`/induction-stove-cost-${s.code.toLowerCase()}/`}>{s.name}</a></li>
      ))}
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
