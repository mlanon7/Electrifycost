---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HeatPumpCalculator from '@/components/HeatPumpCalculator';

const faq = [
  {
    q: 'How much does a 4-ton heat pump cost installed?',
    a: 'A 4-ton (48,000 BTU/hr) heat pump runs $9,500 to $18,000 installed nationally, per NREL benchmark data and 2026 installer surveys. A 4-ton system suits roughly 2,000 to 2,600 sqft in a moderate climate. Cold-climate (NEEP-listed) equipment adds $1,500 to $3,500. State labor rates shift the band — California, Hawaii, and the Northeast run highest.',
  },
  {
    q: 'What size home does a 4-ton heat pump heat and cool?',
    a: 'A 4-ton unit is sized for about 2,000 to 2,600 sqft in a moderate climate (IECC zones 3 to 5), assuming average insulation. Larger or multi-story homes at this footprint often see better comfort from a zoned or two-system design rather than one large unit. A Manual J load calculation by a licensed contractor is the proper sizing method — the per-sqft rule of thumb is a starting point, not a spec.',
  },
  {
    q: 'One 4-ton system or two smaller systems?',
    a: 'For 2,000 to 2,600 sqft, homes with two stories, distinct wings, or uneven loads often do better with two smaller systems or a multi-zone setup than a single 4-ton unit. Zoning lets each area run independently, improves comfort, and lets the equipment modulate instead of short-cycling. The DOE notes right-sizing and zoning improve efficiency; a single 4-ton is simplest and cheapest upfront when the load is even and the layout is open.',
  },
  {
    q: 'What rebates apply to a 4-ton heat pump?',
    a: 'The federal 25C credit expired Dec 31 2025 under OBBBA. State and utility programs plus DOE Home Energy Rebates (where launched) still apply and are not capacity-dependent — they key off equipment efficiency and household income, not tonnage. Use the calculator above to see programs for your state.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '4-Ton Heat Pump Cost',
    description: 'Planning-range installed cost for a 4-ton (48,000 BTU/hr) heat pump, suited to roughly 2,000-2,600 sqft.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  title="4-Ton Heat Pump Cost 2026 — Installed Price by Home & State"
  description="A 4-ton heat pump runs $9,500-$18,000 installed (2,000-2,600 sqft). Larger homes often benefit from a multi-zone design. State-calibrated estimate, sizing, and rebates."
  active="/heat-pump-cost-calculator/"
  ogImage="/assets/topic-images/heat-pump-hero-photo.png"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump calculator', href: '/heat-pump-cost-calculator/' },
    { name: '4-ton', href: '/heat-pump-cost-4-ton/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump · 4-ton</p>
    <h1 class="mt-1 text-3xl md:text-4xl">4-Ton Heat Pump Cost</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      A 4-ton (48,000 BTU/hr) heat pump suits roughly 2,000-2,600 sqft — larger single-family homes. Plan-level installed cost, sizing guidance, and the rebates that still apply in 2026.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $9,500-$18,000 installed; larger homes often benefit from a multi-zone two-system design. Refine by state and home below.
    </p>
  </section>

  <section class="container-wide pb-10"><HeatPumpCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump cost by size</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
      <li><a href="/heat-pump-cost-1-5-ton/">1.5-ton (~600-900 sqft) →</a></li>
      <li><a href="/heat-pump-cost-2-ton/">2-ton (~900-1,300 sqft) →</a></li>
      <li><a href="/heat-pump-cost-3-ton/">3-ton (~1,500-2,000 sqft) →</a></li>
      <li><a href="/heat-pump-cost-5-ton/">5-ton (~2,600-3,200 sqft) →</a></li>
      <li><a href="/heat-pump-cost-2500-sqft/">By home size (sqft) →</a></li>
      <li><a href="/heat-pump-cost-by-state/">By state →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
