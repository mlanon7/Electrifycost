const trustChips = [
  { label: `${sourceCount} primary sources`, href: '/sources/' },
  { label: `${rebateCount} rebate programs`, href: '/rebates/' },
  { label: `${scenarioCount} cost scenarios`, href: '/methodology/' },
  { label: `${stateCount} states + DC`, href: '#states' },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ElectrifyCost',
    alternateName: 'Electrify Cost',
    url: 'https://electrifycost.com/',
    description: 'Source-backed home electrification cost calculators for U.S. homeowners.',
    inLanguage: 'en-US',
    publisher: { '@id': 'https://electrifycost.com/#organization' },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: 'https://electrifycost.com/?s={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://electrifycost.com/#organization',
    name: 'ElectrifyCost',
    url: 'https://electrifycost.com/',
    logo: 'https://electrifycost.com/favicon.svg',
    description: 'Independent, source-backed planning calculators for residential electrification. No email gate, no affiliate funnel.',
    sameAs: [],
  },
];
---
<Layout
  title="Home Electrification Cost Calculator | ElectrifyCost"
  description="Free home electrification cost calculators: HVAC, solar, battery, EV, water heating, insulation, audits. Source-backed. No email gate. 2026 federal credit dates."
  schemaJsonLd={schemaJsonLd}
>
  <section class="relative overflow-hidden border-b border-ink-100 bg-gradient-to-b from-brand-50/70 via-white to-white">
    <div aria-hidden="true" class="absolute inset-0 -z-10 opacity-40">
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M 48 0 L 0 0 0 48" fill="none" stroke="rgba(40,118,70,0.08)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="container-wide grid gap-10 py-14 md:grid-cols-[1.4fr_1fr] md:py-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Home electrification</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl md:text-5xl">
          What will it really cost to electrify your home?
        </h1>
        <p class="mt-4 max-w-2xl text-base text-ink-700 md:text-lg">
          Free, source-backed planning calculators for HVAC (heat pumps, mini-splits, geothermal, AC, ductwork), electrical (panel, EV charger, EV TCO), solar &amp; resilience (solar PV, battery, generator), water heating, and envelope (insulation, windows, audits). Type a ZIP and we auto-detect your state. Current federal + state rebates included (25C/25D/30D expired 2025; 30C through 2026-06-30). No login, no email gate.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {trustChips.map(c => (
            <a href={c.href} class="rounded-full border border-ink-200 bg-white/70 px-3 py-1 text-xs text-ink-700 no-underline shadow-sm hover:bg-ink-50">{c.label}</a>
          ))}
        </div>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/heat-pump-cost-calculator/" class="btn-primary">Open heat pump calculator</a>
          <a href="/methodology/" class="btn-ghost border border-ink-200">How we calculate</a>
        </div>
      </div>

      <div class="hidden md:block" aria-hidden="true">
        <picture>
          <source srcset="/assets/topic-images/whole-home-electrification-hero-photo.avif" type="image/avif" />
          <source srcset="/assets/topic-images/whole-home-electrification-hero-photo.webp" type="image/webp" />
          <img
            src="/assets/topic-images/whole-home-electrification-hero-photo.png"
            alt="Whole-home electrification upgrades in a residential setting"
            width="1200" height="675"
            class="w-full rounded-lg border border-ink-200 bg-white shadow-card"
            loading="eager" decoding="async"
          />
        </picture>
        <div class="mt-4 card relative p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-600">Heat pump &middot; Massachusetts &middot; 2,000 sqft</p>
          <div class="mt-3 grid grid-cols-3 gap-2">
            <div class="rounded-lg border border-ink-200 bg-white p-3">
              <p class="text-[10px] uppercase tracking-wide text-ink-600">Low</p>
              <p class="mt-0.5 text-sm font-semibold tabular-nums text-ink-900">$6,975</p>
            </div>
            <div class="rounded-lg border border-brand-300 bg-brand-50 p-3 ring-1 ring-brand-300">
              <p class="text-[10px] uppercase tracking-wide text-brand-700">Mid</p>
              <p class="mt-0.5 text-sm font-semibold tabular-nums text-ink-900">$11,050</p>
            </div>
            <div class="rounded-lg border border-ink-200 bg-white p-3">
              <p class="text-[10px] uppercase tracking-wide text-ink-600">High</p>
              <p class="mt-0.5 text-sm font-semibold tabular-nums text-ink-900">$18,475</p>
            </div>
          </div>
          <div class="mt-3 rounded-lg border border-brand-200 bg-brand-50 p-3">
            <p class="text-[10px] font-medium uppercase tracking-wide text-brand-700">Net after incentives (mid)</p>
            <p class="mt-0.5 text-base font-semibold text-brand-800 tabular-nums">$6,550</p>
            <p class="mt-1 text-[11px] text-brand-700/80">Mass Save -$4,500 (state, 2026 cap) &middot; 25C federal credit ended Dec 31 2025</p>
          </div>
          <div class="mt-2 flex items-center justify-between text-[10px] text-ink-600">
            <span>Sample preview &mdash; actual amounts vary</span>
            <span>Reviewed 2026-05-13</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="calculators" class="container-wide py-10 md:py-14 scroll-mt-20">
    <h2 class="text-xl font-semibold text-ink-900">Every calculator</h2>
    <p class="mt-1 text-sm text-ink-700">Each tool returns low / mid / high installed cost, itemized breakdown, applicable rebates, monthly bill impact, and a contractor question checklist. Grouped by what you're trying to solve.</p>

    {[
      { label: 'Start here', urls: ['/whole-home-electrification-cost-calculator/', '/home-energy-audit-cost-calculator/', '/insulation-cost-calculator/'] },
      { label: 'HVAC & comfort', urls: ['/heat-pump-cost-calculator/', '/mini-split-heat-pump-cost-calculator/', '/geothermal-heat-pump-cost-calculator/', '/ac-replacement-cost-calculator/', '/ductwork-installation-cost-calculator/', '/smart-thermostat-cost-calculator/'] },
      { label: 'Electrical & EV', urls: ['/electrical-panel-upgrade-cost-calculator/', '/ev-charger-installation-cost-calculator/', '/ev-total-cost-of-ownership-calculator/'] },
      { label: 'Solar & resilience', urls: ['/solar-panel-cost-calculator/', '/home-battery-cost-calculator/', '/generator-cost-calculator/'] },
      { label: 'Water heating & appliances', urls: ['/heat-pump-water-heater-cost-calculator/', '/tankless-water-heater-cost-calculator/', '/induction-stove-cost-calculator/', '/pool-heat-pump-cost-calculator/'] },
      { label: 'Envelope', urls: ['/window-replacement-cost-calculator/'] },
    ].map(group => (
      <div class="mt-8">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-700">{group.label}</h3>
        <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {modules.filter(m => group.urls.includes(m.href)).map(m => (
            <a href={m.href} class="card group flex h-full flex-col p-5 no-underline transition-all hover:-translate-y-0.5 hover:shadow-md">
              <div class={`mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg ${m.iconBg}`}>
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={m.iconPath} /></svg>
              </div>
              <h4 class="text-base font-semibold text-ink-900">{m.title}</h4>
              <p class="mt-1 flex-1 text-sm text-ink-700">{m.pitch}</p>
              <div class="mt-3 flex items-center justify-between">
                <span class="badge text-[11px]">{m.typical}</span>
                <span class="text-sm text-brand-700 group-hover:underline">Open</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="border-t border-ink-100 bg-ink-50/60">
    <div class="container-wide grid gap-6 py-10 md:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-700">Source-backed</h3>
        <p class="mt-2 text-sm text-ink-700">Every cost driver is anchored to IRS, ENERGY STAR, DOE, EIA, BLS, NREL, LBNL, NEEP, ACCA, and ASHRAE data. Sources visible on every calculator.</p>
        <a href="/sources/" class="mt-2 inline-block text-sm">All {sourceCount} sources</a>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-700">Planning ranges</h3>
        <p class="mt-2 text-sm text-ink-700">Estimates are low / mid / high planning ranges, not contractor quotes. They reflect your state, panel size, install difficulty, and timing.</p>
        <a href="/methodology/" class="mt-2 inline-block text-sm">How we calculate</a>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-700">No funnel</h3>
        <p class="mt-2 text-sm text-ink-700">No email gate. No phone form. No referral funnel. Just the numbers and the questions to ask your contractor.</p>
        <a href="/glossary/" class="mt-2 inline-block text-sm">Glossary of terms</a>
      </div>
    </div>
  </section>

  <section class="container-wide py-10 md:py-14">
    <h2 class="text-xl font-semibold text-ink-900">How an ElectrifyCost estimate is built</h2>
    <ol class="mt-5 grid gap-4 md:grid-cols-4">
      <li class="card p-4">
        <div class="text-xs font-semibold text-brand-700">Step 1</div>
        <p class="mt-1 text-sm font-semibold text-ink-900">Equipment baseline</p>
        <p class="mt-1 text-xs text-ink-700">Anchored to DOE / NREL benchmark studies and ENERGY STAR product data, with bands for trim level.</p>
      </li>
      <li class="card p-4">
        <div class="text-xs font-semibold text-brand-700">Step 2</div>
        <p class="mt-1 text-sm font-semibold text-ink-900">Local labor &amp; permits</p>
        <p class="mt-1 text-xs text-ink-700">BLS Occupational Wage Statistics scaled by state cost-of-living, plus typical permit fees.</p>
      </li>
      <li class="card p-4">
        <div class="text-xs font-semibold text-brand-700">Step 3</div>
        <p class="mt-1 text-sm font-semibold text-ink-900">Panel risk &amp; complexity</p>
        <p class="mt-1 text-xs text-ink-700">Probabilistic adders for panel upgrades, ductwork, condensate, and tight-space installs.</p>
      </li>
      <li class="card p-4">
        <div class="text-xs font-semibold text-brand-700">Step 4</div>
        <p class="mt-1 text-sm font-semibold text-ink-900">Stack incentives</p>
        <p class="mt-1 text-xs text-ink-700">Apply the federal 30C EV credit (through 2026-06-30), state programs, DOE Home Energy Rebates where launched, and utility offers. The federal 25C credit ended on 2025-12-31.</p>
      </li>
    </ol>
  </section>

  <section id="states" class="border-t border-ink-100 scroll-mt-20">
    <div class="container-wide py-10">
      <h2 class="text-xl font-semibold text-ink-900">Heat pump cost by state</h2>
      <p class="mt-1 text-sm text-ink-700">Each state page calibrates labor multipliers, retail electricity rates, climate zone, and applicable rebates.</p>
      <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 lg:grid-cols-4">
        {ALL_STATES.map(s => (
          <li><a class="block py-1 text-brand-700 hover:underline" href={`/heat-pump-cost-${s.code.toLowerCase()}/`}>{s.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
