<Layout title="Wood + Pellet Stoves 2026: EPA, Cost, Alternatives" description="Guide to wood and pellet stoves: EPA 2020 certification, catalytic vs non-catalytic, stovepipe + hearth requirements, and when to choose vs heat pump." active="/guides/wood-pellet-stoves/" schemaJsonLd={schemaJsonLd} ogImage="/assets/topic-images/heat-pump-hero-photo.png" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: 'Wood + pellet stoves', href: '/guides/wood-pellet-stoves/' }]}>
