<Layout
  title="Ductwork Guide 2026: Leakage, Sealing, Heat Pump Sizing"
  description="Long-form guide to residential ductwork: leakage reality, Manual D design, materials (flex / sheet metal / duct board), sealing methods (mastic /."
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/heat-pump-hero-photo.jpg"
