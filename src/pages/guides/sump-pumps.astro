<Layout title="Sump Pumps + Battery Backup in 2026" description="Sump pump guide: why battery backup matters more than horsepower, combo vs water-powered vs smart, and how to size for your basement risk." active="/guides/sump-pumps/" schemaJsonLd={schemaJsonLd} ogImage="/assets/topic-images/generator-hero-photo.png" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: 'Sump pumps', href: '/guides/sump-pumps/' }]}>
