---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HeatPumpCalculator from '@/components/HeatPumpCalculator';

const faq = [
  {
    q: 'How much does a 2-ton heat pump cost installed?',
    a: 'A 2-ton (24,000 BTU/hr) heat pump runs $6,500 to $13,000 installed nationally, per NREL benchmark data and 2026 installer surveys. A 2-ton system suits roughly 900 to 1,300 sqft in a moderate climate. Cold-climate (NEEP-listed) equipment adds $1,500 to $3,000. State labor rates shift the band — California, Hawaii, and the Northeast run highest.',
  },
  {
    q: 'What size home does a 2-ton heat pump heat and cool?',
    a: 'A 2-ton unit is sized for about 900 to 1,300 sqft in a moderate climate (IECC zones 3 to 5), assuming average insulation. Tighter, newer homes may be comfortable toward the top of that range; older, leaky homes toward the bottom or a size up. A Manual J load calculation by a licensed contractor is the proper sizing method — the per-sqft rule of thumb is a starting point, not a spec.',
  },
  {
    q: 'Ducted central or a 2-zone mini-split at this size?',
    a: 'Both work for 900 to 1,300 sqft. If you already have sound ductwork, a 2-ton ducted central system is usually the simplest, lowest-cost path. If you have no ducts or want room-by-room control, a two-zone ductless mini-split avoids the 20 to 30 percent duct losses ENERGY STAR cites and lets you condition only the spaces in use. New ductwork for a ducted system can add $1,500 to $8,000, which often tips the math toward ductless.',
  },
  {
    q: 'What rebates apply to a 2-ton heat pump?',
    a: 'The federal 25C credit expired Dec 31 2025 under OBBBA. State and utility programs plus DOE Home Energy Rebates (where launched) still apply and are not capacity-dependent — they key off equipment efficiency and household income, not tonnage. Use the calculator above to see programs for your state.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '2-Ton Heat Pump Cost',
    description: 'Planning-range installed cost for a 2-ton (24,000 BTU/hr) heat pump, suited to roughly 900-1,300 sqft.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  title="2-Ton Heat Pump Cost 2026 — Installed Price"
  description="A 2-ton heat pump runs $6,500-$13,000 installed (900-1,300 sqft). Cold-climate adds $1,500-$3,000. State-calibrated estimate, sizing, and rebates."
  active="/heat-pump-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/heat-pump-hero-photo.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump calculator', href: '/heat-pump-cost-calculator/' },
    { name: '2-ton', href: '/heat-pump-cost-2-ton/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump · 2-ton</p>
    <h1 class="mt-1 text-3xl md:text-4xl">2-Ton Heat Pump Cost</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      A 2-ton (24,000 BTU/hr) heat pump suits roughly 900-1,300 sqft — small to mid-size homes. Plan-level installed cost, sizing guidance, and the rebates that still apply in 2026.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $6,500-$13,000 installed; cold-climate adds $1,500-$3,000. Refine by state and home below.
    </p>
  </section>

  <section class="container-wide pb-10"><HeatPumpCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump cost by size</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
      <li><a href="/heat-pump-cost-1-5-ton/">1.5-ton (~600-900 sqft) →</a></li>
      <li><a href="/heat-pump-cost-3-ton/">3-ton (~1,500-2,000 sqft) →</a></li>
      <li><a href="/heat-pump-cost-4-ton/">4-ton (~2,000-2,600 sqft) →</a></li>
      <li><a href="/heat-pump-cost-5-ton/">5-ton (~2,600-3,200 sqft) →</a></li>
      <li><a href="/heat-pump-cost-1500-sqft/">By home size (sqft) →</a></li>
      <li><a href="/heat-pump-cost-by-state/">By state →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
