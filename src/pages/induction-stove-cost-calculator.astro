---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import AffiliateModule from '@/components/AffiliateModule.astro';
import InductionCalculator from '@/components/InductionCalculator';

const faq = [
  {
    q: 'How much does it cost to switch from gas to induction?',
    a: 'A basic 30-inch induction range installs for $1,500 to $3,500, per NREL benchmark data and 2026 installer surveys. Coming from gas adds $400 to $1,300 for a new 240V circuit and $150 to $450 to cap the gas line. A starter induction cookware allowance adds $75 to $450 if your existing pots arent ferromagnetic.',
  },
  {
    q: 'Do I need a 240V outlet for an induction range?',
    a: 'Yes, full-size induction ranges require a dedicated 240V/40-50A circuit (typically NEMA 14-50), just like a traditional electric range. Plug-in induction cooktops can run on standard 120V outlets but are limited to about 1,800W total power.',
  },
  {
    q: 'Will my pots and pans work?',
    a: 'Most stainless steel and cast-iron pans work. Aluminum and copper-only pans do not. The magnet test is the quickest check: if a magnet sticks firmly to the bottom of the pan, it is induction-compatible.',
  },
  {
    q: 'Does the federal 25C credit cover induction stoves?',
    a: 'No, ranges and cooktops are not 25C-eligible and 25C ended Dec 31, 2025 under OBBBA. Income-qualified households may qualify for a DOE Home Energy Rebate (HEEHRA) of up to $840 for an electric stove/cooktop/range, administered by states. Track program status at https://www.energy.gov/scep/home-energy-rebates-programs.',
  },
  {
    q: 'What are the indoor-air-quality benefits of induction?',
    a: 'No combustion in the kitchen means no NO2, CO, or formaldehyde from cooking, and no methane leakage from the gas connection. The Stanford and CARB studies found gas stoves elevate household NO2 to levels EPA would not allow outdoors. For households with asthma or young children this is one of the bigger health-driven motivators to switch.',
  },
  {
    q: 'Range vs cooktop vs portable: which one fits?',
    a: 'A full-size range (30/36 inch, $1,500–$6,500 installed, per NREL benchmark data) is the all-in-one swap. A cooktop ($800–$2,400) plus a separate wall oven works for renovations. A portable single-burner unit ($75–$250) is the gateway drug: borrow one for a week before committing. Sizing-wise, 30 inch is the US default; 36 inch suits serious home cooks.',
  },
  {
    q: 'Is induction safe around pacemakers or kids?',
    a: 'For pacemakers, manufacturers (Medtronic, Boston Scientific) recommend at least 24 inches between the device and an active induction burner, the same rule as for arc-welding equipment. Most patients can cook normally; check with your cardiologist. For kids, the cooktop glass only heats where the pan transfers heat back, so it cools faster than a gas burner. The pan and any spilled liquid stay hot, so normal stovetop precautions apply.',
  },
  {
    q: 'What brand should I look at?',
    a: 'Yale Appliance 2026 service-call data ranks LG, GE Profile, and Cafe as the most reliable induction-range brands. Frigidaire ($1,099) and GE Profile ($1,499) are the value picks; Bosch 500 ($2,099) and Cafe ($3,000+) are the mid-range; Wolf, Miele, and Thermador are the premium tier. https://blog.yaleappliance.com/most-reliable-induction-ranges',
  },
  {
    q: 'Do I still need a range hood?',
    a: 'Yes. Even without combustion gases, cooking releases steam, smoke, oil aerosols, and PM2.5 particulates. ASHRAE 62.2 recommends at least 100 CFM exhaust to outside, captured under a hood that covers the full cooktop. A recirculating (ductless) hood is a poor substitute when a vented run is feasible.',
  },
  {
    q: 'What questions should I ask the contractor?',
    a: 'See the contractor checklist next to the calculator result above. It covers panel capacity for the new 240V circuit, gas-line cap by a licensed plumber, range-hood CFM and venting, anti-tip bracket, and cookware compatibility before delivery.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Induction Stove Cost Calculator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: 'Free planning-range calculator for induction range and cooktop installations including 240V circuit, gas line cap, and cookware allowance.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title="Induction Stove Cost Calculator: Gas-to-Induction Conversion"
  description="Estimate the installed cost of switching from gas to an induction range or cooktop, including 240V circuit work, gas line capping, and cookware allowance. 2026."
  active="/induction-stove-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/induction-stove-hero-photo.png"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Induction stove cost calculator', href: '/induction-stove-cost-calculator/' },
  ]}
>
  <section class="container-wide grid gap-6 py-8 md:grid-cols-[minmax(0,1fr)_420px] md:items-center md:py-10">
    <div>
      <p class="eyebrow">Induction stove</p>
      <h1 class="mt-1 text-3xl md:text-4xl">Induction Stove Cost Calculator</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
        Plan-level installed cost for an induction range or cooktop, including a new 240V circuit, gas line cap, and a starter cookware allowance.
      </p>
      <p class="mt-3 rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
        <strong>Quick answer:</strong> a basic 30-inch induction range installs for $1,500–$3,500. Coming from gas adds $400–$1,300 for a new 240V circuit and $150–$450 for a licensed-plumber gas-line cap. Income-qualified DOE rebate up to $840 in open states. Federal 25C does not apply.
      </p>
    </div>
    <picture>
      <source srcset="/assets/topic-images/induction-stove-hero-photo.avif" type="image/avif" />
      <source srcset="/assets/topic-images/induction-stove-hero-photo.webp" type="image/webp" />
      <img src="/assets/topic-images/induction-stove-hero-photo.png"
        alt="Induction range and cooktop in a modern kitchen"
        width="1200" height="675"
        class="w-full rounded-lg border border-ink-200 bg-white shadow-card"
        loading="eager" decoding="async" />
    </picture>
  </section>

  <section class="container-wide pb-10"><InductionCalculator client:load /></section>

  <AffiliateDisclosure />
  <AffiliateModule kind="induction" />

  <section class="container-wide py-8 border-t border-ink-100">
    <div class="max-w-prose">
      <h2 class="text-xl font-semibold text-ink-900">New to induction cooking?</h2>
      <p class="mt-2 text-sm text-ink-700">
        Induction heats the <em>pan</em>, not the burner: an electromagnetic field induces eddy currents in any ferromagnetic cookware (cast iron, magnetic stainless, carbon steel). The cooktop glass stays cool except where the pan transfers heat back. 85% efficient at the pan vs. 40% for gas; water boils in half the time. Quick test for cookware: if a fridge magnet sticks to the pan bottom, it works. A range needs a 240V/40–50A circuit; if you are coming from gas you also need a licensed plumber to cap the gas line.
      </p>
      <p class="mt-3 text-sm">
        <a href="/guides/induction-cooking/" class="font-medium text-brand-700">Read the full guide</a>
        <span class="ml-2 text-ink-500">6-min read</span>
      </p>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Related calculators</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
      <li><a href="/heat-pump-cost-calculator/">Heat pump cost calculator</a></li>
      <li><a href="/electrical-panel-upgrade-cost-calculator/">Electrical panel upgrade cost calculator</a></li>
      <li><a href="/ev-charger-installation-cost-calculator/">EV charger installation cost calculator</a></li>
      <li><a href="/heat-pump-water-heater-cost-calculator/">Heat pump water heater cost calculator</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
