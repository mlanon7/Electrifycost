---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import { ALL_STATES, findStateEnergy, findStateLabor } from '@/lib/data';

const rows = ALL_STATES.map(s => {
  const energy = findStateEnergy(s.code);
  const labor  = findStateLabor(s.code);
  return {
    code: s.code,
    name: s.name,
    ecents: energy?.electricity_cents_per_kwh ?? 0,
    elec:   labor?.electrician_multiplier ?? 1,
  };
}).sort((a, b) => a.name.localeCompare(b.name));

const cheapElec = [...rows].sort((a, b) => a.ecents - b.ecents).slice(0, 5);
const expElec   = [...rows].sort((a, b) => b.ecents - a.ecents).slice(0, 5);

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'EV Charger Install Cost by State',
    description: 'Installed-cost estimates, retail electricity prices, and electrician labor multipliers for Level 2 EV chargers in every U.S. state plus DC.',
  },
];
---
<Layout
  title="EV Charger Install Cost by State 2026"
  description="Level 2 EV charger installed cost, retail electricity rate, and electrician labor multiplier for every U.S. state plus DC."
  active="/ev-charger-installation-cost-calculator/"
  ogImage="/assets/topic-images/ev-charger-hero-photo.jpg"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'EV charger calculator', href: '/ev-charger-installation-cost-calculator/' },
    { name: 'By state', href: '/ev-charger-installation-cost-by-state/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">EV charger install</p>
    <h1 class="mt-1 text-3xl md:text-4xl">EV Charger Install Cost by State</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      Level 2 EV charger installation runs $800–$2,800 nationally, but local electrician labor and panel work change the number meaningfully by state. Below: 51 state pages with calibrated cost ranges, retail electricity rates, and applicable incentive programs.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $800–$2,800 typical install; $4,500+ for trenched detached-garage runs; +$2,000–$4,500 if a panel upgrade is required. The federal 30C credit (30% up to $1,000) expired for chargers placed in service after June 30, 2026.
    </p>
  </section>

  <section class="container-wide pb-8">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="card p-4">
        <p class="eyebrow">Cheapest electricity (¢/kWh)</p>
        <p class="mt-1 text-xs text-ink-600">Lowest home-charging operating cost</p>
        <ul class="mt-2 space-y-1 text-sm text-ink-700">
          {cheapElec.map(s => <li class="flex justify-between"><a href={`/ev-charger-installation-cost-${s.code.toLowerCase()}/`}>{s.name}</a><span class="tabular-nums">{s.ecents.toFixed(1)}¢</span></li>)}
        </ul>
      </div>
      <div class="card p-4">
        <p class="eyebrow">Most expensive electricity</p>
        <p class="mt-1 text-xs text-ink-600">Check off-peak / EV time-of-use rates here</p>
        <ul class="mt-2 space-y-1 text-sm text-ink-700">
          {expElec.map(s => <li class="flex justify-between"><a href={`/ev-charger-installation-cost-${s.code.toLowerCase()}/`}>{s.name}</a><span class="tabular-nums">{s.ecents.toFixed(1)}¢</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-wide pb-10">
    <h2 class="text-xl">All 50 states + DC</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
          <tr>
            <th class="py-2 pr-3">State</th>
            <th class="py-2 pr-3 tabular-nums">Electricity</th>
            <th class="py-2 pr-3 tabular-nums">Electrician labor</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr class="border-b border-ink-100">
              <td class="py-2 pr-3"><a href={`/ev-charger-installation-cost-${r.code.toLowerCase()}/`} class="font-medium">{r.name}</a></td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.ecents.toFixed(1)}¢/kWh</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.elec.toFixed(2)}×</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide pb-12">
    <div class="card p-5">
      <h2 class="text-lg">Next steps</h2>
      <p class="mt-2 max-w-prose text-sm text-ink-700">
        For a planning-range cost calibrated to your home — panel size, garage type, amperage choice — use the <a href="/ev-charger-installation-cost-calculator/" class="text-brand-700 font-medium">EV charger cost calculator</a>. For background on Level 1 vs 2, NEC sizing, NACS connectors, and the 30C credit, read the <a href="/guides/ev-chargers/" class="text-brand-700 font-medium">EV chargers guide</a>.
      </p>
    </div>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
