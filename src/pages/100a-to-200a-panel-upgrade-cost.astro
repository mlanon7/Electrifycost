---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import PanelCalculator from '@/components/PanelCalculator';

const faq = [
  {
    q: 'How much does a 100A to 200A panel upgrade cost?',
    a: 'A typical 100A→200A upgrade is $2,000–$4,500 installed nationally, with high-cost markets (California, Hawaii, NYC metro) running $4,500–$7,500. The work usually includes a new 200A main breaker, a new meter base, replacement of the service-entrance conductors, grounding/bonding to current code, and a utility coordination visit.',
  },
  {
    q: 'Is a 200A panel always necessary for an all-electric home?',
    a: 'No. NEC 220.83 load calculations frequently show a 100A panel can handle a heat pump + EV charger + induction range if existing loads are modest. A smart load-management device ($500–$1,500) often replaces a $4,000 upgrade by scheduling large loads so the home never exceeds the existing service capacity. Always have a licensed electrician run the load calc before committing.',
  },
  {
    q: 'What is the federal tax credit on a panel upgrade in 2026?',
    a: 'The federal 25C credit covered panels up to $600 (30% of cost) when paired with a qualified energy efficiency improvement, but OBBBA (signed July 4, 2025) terminated 25C for property placed in service after December 31, 2025. For installs in 2026 or later, no federal credit applies. State and utility rebates may still apply — see /rebates/. IRS reference: https://www.irs.gov/credits-deductions/energy-efficient-home-improvement-credit',
  },
  {
    q: 'How long does the work take, and how long is power off?',
    a: 'A typical 100A→200A service upgrade is a one-day job, but power is off for 4–8 hours during the cutover. If the utility has to replace the service drop or relocate the meter, the calendar can stretch to 2–3 weeks even though on-site work is still a day or two. The utility part is usually free; the electrician\'s part is the cost.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '100A to 200A Panel Upgrade Cost',
    description: 'Planning-range installed cost for upgrading a 100A electrical panel to 200A, with state labor multipliers and the panel-replacement vs. service-upgrade cost split.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title="100A to 200A Panel Upgrade Cost 2026"
  description="Plan-level cost for a 100A to 200A electrical panel upgrade. State labor multipliers, utility coordination, NEC load-calculation reality."
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/panel-upgrade-hero-photo.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Panel upgrade calculator', href: '/electrical-panel-upgrade-cost-calculator/' },
    { name: '100A to 200A', href: '/100a-to-200a-panel-upgrade-cost/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Panel upgrade · 100A → 200A</p>
    <h1 class="mt-1 text-3xl md:text-4xl">100A to 200A Panel Upgrade Cost</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      The single most common residential panel upgrade. Plan-level installed cost with state labor multipliers, meter/main replacement, utility coordination, and the panel-replacement vs. service-upgrade cost split.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $2,000–$4,500 typical, $4,500–$7,500 in high-cost markets (CA, HI, NYC). A smart load-management device ($500–$1,500) is often a cheaper alternative — see below.
    </p>
  </section>

  <section class="container-wide pb-10"><PanelCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Related</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
      <li><a href="/electrical-panel-upgrade-cost-calculator/">Main panel upgrade calculator →</a></li>
      <li><a href="/200a-to-400a-panel-upgrade-cost/">200A to 320/400A upgrade cost →</a></li>
      <li><a href="/subpanel-cost/">Subpanel install cost →</a></li>
      <li><a href="/load-management-vs-panel-upgrade/">Load management vs panel upgrade →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
