---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HpwhCalculator from '@/components/HpwhCalculator';
import { brandsByCategory } from '@/lib/data';

export async function getStaticPaths() {
  return brandsByCategory('hpwh').map(b => ({ params: { brand: b.slug }, props: { b } }));
}

const { b } = Astro.props as { b: import('@/lib/data').BrandProfile };
const siblings = brandsByCategory('hpwh').filter(x => x.slug !== b.slug);

const tierVerdict = b.tier === 'premium'
  ? `${b.brand} is a premium HPWH option — you pay more for build quality or cold-climate performance. Worth it if those matter for your install location.`
  : b.tier === 'value'
  ? `${b.brand} is a value HPWH — lower cost with solid performance for typical conditioned-space installs.`
  : `${b.brand} is a mid-tier HPWH — a balance of price and availability. Install location and electrician cost matter more than small brand differences.`;

const description = `${b.brand} heat pump water heater cost in 2026: installed price, model lineup, and brand positioning. ${b.positioning}.`;

const faq = [
  {
    q: `How much does a ${b.brand} heat pump water heater cost installed?`,
    a: `A ${b.brand} hybrid HPWH typically runs $2,200 to $4,200 installed for a 50-gallon unit, per NREL benchmark data and 2026 installer surveys. ${b.price_note}. Cost depends on whether you need a new 240V circuit, electrical panel work, and condensate routing. Use the calculator below to refine for your state and install location.`,
  },
  {
    q: `Which ${b.brand} HPWH models should I look at?`,
    a: `${b.brand}'s common HPWH lines are: ${b.models}. ${b.positioning}. Check the UEF (uniform energy factor) rating and the rated first-hour delivery for your household size. Per the U.S. Department of Energy, ENERGY STAR HPWHs run UEF 3.0 to 4.0 vs. about 0.9 for an electric resistance tank.`,
  },
  {
    q: `Is ${b.brand} worth it vs. other HPWH brands?`,
    a: `${tierVerdict} The biggest cost lever is the install location (a conditioned basement vs. a tight closet needing ducting) and the electrician's circuit work, not the brand badge.`,
  },
  {
    q: `What rebates apply to a ${b.brand} HPWH?`,
    a: `Rebates key off efficiency and income, not brand. The federal 25C credit (which covered HPWHs up to $2,000) expired Dec 31 2025 under OBBBA; DOE HEEHRA provides up to $1,750 for income-qualified households where the state has launched, plus state and utility programs. The calculator below shows what applies in your state.`,
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    name: `${b.brand} Heat Pump Water Heater Cost`,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  title={`${b.brand} Heat Pump Water Heater Cost 2026`}
  description={description}
  active="/heat-pump-water-heater-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/heat-pump-water-heater-hero-photo.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'HPWH calculator', href: '/heat-pump-water-heater-cost-calculator/' },
    { name: b.brand, href: `/${b.slug}-heat-pump-water-heater-cost/` },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump water heater · {b.brand}</p>
    <h1 class="mt-1 text-3xl md:text-4xl">{b.brand} Heat Pump Water Heater Cost</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      {b.positioning}. Plan-level installed cost, model lineup, and where {b.brand} sits among HPWH brands. The calculator below keys the estimate to your state and install location.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> a {b.brand} 50-gallon hybrid HPWH runs about $2,200-$4,200 installed. {b.price_note}.
    </p>
  </section>

  <section class="container-wide pb-10"><HpwhCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Compare other HPWH brands</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {siblings.map(s => (
        <li><a href={`/${s.slug}-heat-pump-water-heater-cost/`}>{s.brand} HPWH cost <span aria-hidden="true">→</span></a></li>
      ))}
      <li><a href="/heat-pump-water-heater-cost-calculator/">Main calculator <span aria-hidden="true">→</span></a></li>
      <li><a href="/heat-pump-water-heater-cost-by-state/">By state <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
