---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HpwhCalculator from '@/components/HpwhCalculator';
import {
  ALL_CITIES,
  findCity,
  stateName,
  findStateEnergy,
  findStateLabor,
  rebatePrograms,
} from '@/lib/data';
import { fmtUSD } from '@/lib/format';

export async function getStaticPaths() {
  return ALL_CITIES.map(c => ({ params: { city: c.slug } }));
}

const { city: citySlug } = Astro.params as { city: string };
const meta = findCity(citySlug)!;
const cityName = meta.city;
const stateCode = meta.state;
const stName = stateName(stateCode);
const energy = findStateEnergy(stateCode);
const labor = findStateLabor(stateCode);

const stateRebates = rebatePrograms.filter(
  r => (r.module === 'hpwh' || r.module === '') &&
       (r.state === stateCode || r.scope === 'federal')
);

const electricityCents = energy?.electricity_cents_per_kwh ?? 0;
const hvacMult = labor?.hvac_multiplier ?? 1;
const plumberMult = labor?.plumber_multiplier ?? 1;
const blendedMult = (hvacMult + plumberMult) / 2;
const monthlyOp = (1500 * electricityCents) / 1200;

const description = `Heat pump water heater installed cost in ${cityName}, ${stateCode}: ${stName} HVAC+plumber labor ${blendedMult.toFixed(2)}×, ${electricityCents.toFixed(1)}¢/kWh, ${stateRebates.length} programs.`;

const faq = [
  {
    q: `How much does a heat pump water heater cost in ${cityName}?`,
    a: `In ${cityName}, ${stateCode}, a 50-gallon hybrid HPWH typically runs ${fmtUSD(2200 * blendedMult)}–${fmtUSD(4200 * blendedMult)} installed, scaled to ${stName} labor rates. A 120V plug-in unit is cheaper. The calculator above refines for capacity, voltage, and install location.`,
  },
  {
    q: `What is the monthly operating cost in ${cityName}?`,
    a: `At ${stName} retail electricity of ${electricityCents.toFixed(1)} cents/kWh, an HPWH for a 4-person household in ${cityName} costs about ${fmtUSD(monthlyOp)} per month to run — roughly 1/3 the energy use of a standard electric tank water heater.`,
  },
  {
    q: `What rebates apply to HPWHs in ${cityName}?`,
    a: `The federal 25C credit (which covered HPWHs up to $2,000) expired Dec 31 2025 under OBBBA. DOE HEEHRA provides up to $1,750 for HPWHs in income-qualified households where ${stName} has launched the program. The table above shows ${stateRebates.length} applicable programs.`,
  },
  {
    q: 'Where should an HPWH be installed?',
    a: 'HPWHs need about 700 cubic feet of free air to maintain efficiency. A conditioned basement or utility room works well; an unconditioned garage is fine in moderate climates but risky where winter ambient drops below the unit cutoff temperature.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `HPWH Cost Calculator — ${cityName}, ${stateCode}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title={`Heat Pump Water Heater Cost in ${cityName}, ${stateCode}`}
  description={description}
  active="/heat-pump-water-heater-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'HPWH calculator', href: '/heat-pump-water-heater-cost-calculator/' },
    { name: stName, href: `/heat-pump-water-heater-cost-${stateCode.toLowerCase()}/` },
    { name: cityName, href: `/heat-pump-water-heater-cost/${citySlug}/` },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{cityName}, {stateCode}</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Heat Pump Water Heater Cost in {cityName}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 md:text-base">
      Estimate the installed cost of a hybrid HPWH in {cityName}, {stateCode}. Calibrated to {stName} HVAC + plumber labor ({blendedMult.toFixed(2)}x) and retail electricity ({electricityCents.toFixed(1)} cents/kWh).
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Labor blend</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{blendedMult.toFixed(2)}x</div>
        <div class="text-xs text-ink-500">{stName} HVAC + plumber</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Electricity</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{electricityCents.toFixed(1)} cents/kWh</div>
        <div class="text-xs text-ink-500">{stName} EIA average</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">HPWH operating</div>
        <div class="mt-1 text-base font-semibold text-ink-900">${monthlyOp.toFixed(0)}/mo</div>
        <div class="text-xs text-ink-500">4-person household</div>
      </div>
    </div>
    <p class="mt-3 text-xs text-ink-500">
      City estimates use {stName} state-level labor and energy data. For the full state view, see <a href={`/heat-pump-water-heater-cost-${stateCode.toLowerCase()}/`} class="text-brand-700 hover:underline">HPWH cost in {stName}</a>.
    </p>
  </section>

  <section class="container-wide pb-10">
    <HpwhCalculator client:load initialState={stateCode} />
  </section>

  <section class="container-wide py-10">
    <h2 class="text-xl font-semibold text-ink-900">HPWH rebates &amp; credits in {stName}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="py-2 pr-3">Program</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Amount</th>
            <th class="py-2 pr-3">Expires</th>
          </tr>
        </thead>
        <tbody>
          {stateRebates.map(p => (
            <tr class="border-b border-ink-100 align-top">
              <td class="py-2 pr-3">
                <div class="font-medium text-ink-900">
                  {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                </div>
                {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.scope === 'federal' ? 'Federal' : p.scope === 'state' ? 'State' : 'Utility'} · {p.incentive_type === 'tax_credit' ? 'Credit' : 'Rebate'}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-900">
                {p.percent > 0 ? `${p.percent}% up to $${p.cap.toLocaleString()}` :
                  p.amount_low === p.amount_high ? `$${p.amount_high.toLocaleString()}` :
                  `$${p.amount_low.toLocaleString()}–$${p.amount_high.toLocaleString()}`}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.expiration_date && p.expiration_date !== 'unspecified' && p.expiration_date !== 'none' ? p.expiration_date : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">HPWH cost in other cities</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {ALL_CITIES.map(c => (
        <li><a href={`/heat-pump-water-heater-cost/${c.slug}/`}>{c.city}, {c.state}</a></li>
      ))}
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
