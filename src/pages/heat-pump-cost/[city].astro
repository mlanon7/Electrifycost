---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HeatPumpCalculator from '@/components/HeatPumpCalculator';
import {
  ALL_CITIES,
  findCity,
  stateName,
  findStateEnergy,
  findStateLabor,
  findClimate,
  rebatePrograms,
} from '@/lib/data';
import { fmtUSD } from '@/lib/format';

export async function getStaticPaths() {
  return ALL_CITIES.map(c => ({ params: { city: c.slug } }));
}

const { city: citySlug } = Astro.params as { city: string };
const meta = findCity(citySlug)!;
const cityName = meta.city;
const stateCode = meta.state;
const stName = stateName(stateCode);
const energy = findStateEnergy(stateCode);
const labor = findStateLabor(stateCode);
const climate = findClimate(stateCode);

const stateRebates = rebatePrograms.filter(
  r => (r.module === 'heat_pump' || r.module === '') &&
       (r.state === stateCode || r.scope === 'federal')
);

const isCold = climate?.heat_pump_class === 'coldclimate';
const electricityCents = energy?.electricity_cents_per_kwh ?? 0;
const hvacMult = labor?.hvac_multiplier ?? 1;

const description = `Estimate heat pump installed cost in ${cityName}, ${stateCode}. Calibrated to ${stName} HVAC labor (${hvacMult.toFixed(2)}x), retail electricity ${electricityCents.toFixed(1)} cents/kWh, and ${isCold ? 'cold' : 'standard'} climate. ${stateRebates.length} applicable incentive programs.`;

const faq = [
  {
    q: `How much does a heat pump cost in ${cityName}?`,
    a: `In ${cityName}, ${stateCode}, a typical ducted central heat pump runs ${fmtUSD(7500 * hvacMult)}–${fmtUSD(20000 * hvacMult)} installed, scaled to ${stName} HVAC labor rates. Cold-climate equipment runs higher. Use the calculator above to refine for your home size, current fuel, panel, and ductwork.`,
  },
  {
    q: `Is a heat pump worth it in ${cityName}?`,
    a: isCold
      ? `${cityName} sits in a cold climate zone (${climate?.iecc_zone ?? 'n/a'}, ${climate?.heating_degree_days?.toLocaleString() ?? 'n/a'} HDD). A cold-climate-rated or dual-fuel heat pump is the most reliable choice here. Operating savings vs. heating oil and propane are largest in cold climates.`
      : `${cityName} sits in a moderate climate zone (${climate?.iecc_zone ?? 'n/a'}, ${climate?.heating_degree_days?.toLocaleString() ?? 'n/a'} HDD). Standard air-source heat pumps work well year-round. Operating-cost change depends on local electricity (${electricityCents.toFixed(1)} cents/kWh) vs. your current fuel.`,
  },
  {
    q: `What rebates are available for a heat pump in ${cityName}?`,
    a: `The federal 25C credit expired Dec 31 2025 under OBBBA. ${stName} homeowners in ${cityName} can still combine applicable state programs and DOE Home Energy Rebates where ${stName} has launched the program. The rebate table above shows ${stateRebates.length} programs applicable to your location.`,
  },
  {
    q: `Do I need a panel upgrade for a heat pump in ${cityName}?`,
    a: 'Not always. A 200A panel is usually fine; a 100A panel often works after an NEC 220.83 load calculation; a 60A service almost always needs an upgrade. The calculator above includes a panel-risk verdict for your selection.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Heat Pump Cost Calculator — ${cityName}, ${stateCode}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title={`Heat Pump Cost in ${cityName}, ${stateCode} — Install Price & Rebates`}
  description={description}
  active="/heat-pump-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump calculator', href: '/heat-pump-cost-calculator/' },
    { name: stName, href: `/heat-pump-cost-${stateCode.toLowerCase()}/` },
    { name: cityName, href: `/heat-pump-cost/${citySlug}/` },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{cityName}, {stateCode}</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Heat Pump Cost in {cityName}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 md:text-base">
      Estimate the installed cost, applicable rebates, and operating-cost change for a heat pump in {cityName}, {stateCode}. Calibrated to {stName} HVAC labor ({hvacMult.toFixed(2)}x), retail electricity ({electricityCents.toFixed(1)} cents/kWh), and {isCold ? 'cold' : 'standard'} climate.
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-4">
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Climate zone</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{climate?.iecc_zone ?? 'n/a'}</div>
        <div class="text-xs text-ink-500">{climate?.heating_degree_days?.toLocaleString() ?? 'n/a'} HDD</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Electricity</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{electricityCents.toFixed(1)} cents/kWh</div>
        <div class="text-xs text-ink-500">{stName} EIA average</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">HVAC labor</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{hvacMult.toFixed(2)}x</div>
        <div class="text-xs text-ink-500">vs. U.S. average</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Heat pump class</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{isCold ? 'Cold-climate' : 'Standard'}</div>
        <div class="text-xs text-ink-500">recommended</div>
      </div>
    </div>
    <p class="mt-3 text-xs text-ink-500">
      City estimates use {stName} state-level labor and energy data. For the full state view, see <a href={`/heat-pump-cost-${stateCode.toLowerCase()}/`} class="text-brand-700 hover:underline">heat pump cost in {stName}</a>.
    </p>
  </section>

  <section class="container-wide pb-10">
    <HeatPumpCalculator client:load initialState={stateCode} />
  </section>

  <section class="container-wide py-10">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump rebates &amp; credits in {stName}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="py-2 pr-3">Program</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Amount</th>
            <th class="py-2 pr-3">Expires</th>
          </tr>
        </thead>
        <tbody>
          {stateRebates.map(p => (
            <tr class="border-b border-ink-100 align-top">
              <td class="py-2 pr-3">
                <div class="font-medium text-ink-900">
                  {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                </div>
                {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.scope === 'federal' ? 'Federal' : p.scope === 'state' ? 'State' : 'Utility'} · {p.incentive_type === 'tax_credit' ? 'Credit' : 'Rebate'}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-900">
                {p.percent > 0 ? `${p.percent}% up to $${p.cap.toLocaleString()}` :
                  p.amount_low === p.amount_high ? `$${p.amount_high.toLocaleString()}` :
                  `$${p.amount_low.toLocaleString()}–$${p.amount_high.toLocaleString()}`}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.expiration_date && p.expiration_date !== 'unspecified' && p.expiration_date !== 'none' ? p.expiration_date : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump cost in other cities</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {ALL_CITIES.map(c => (
        <li><a href={`/heat-pump-cost/${c.slug}/`}>{c.city}, {c.state}</a></li>
      ))}
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
