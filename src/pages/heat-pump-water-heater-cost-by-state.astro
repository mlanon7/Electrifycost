---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import { ALL_STATES, findStateEnergy, findStateLabor, findClimate } from '@/lib/data';

const rows = ALL_STATES.map(s => {
  const energy = findStateEnergy(s.code);
  const labor  = findStateLabor(s.code);
  const climate = findClimate(s.code);
  return {
    code: s.code,
    name: s.name,
    ecents: energy?.electricity_cents_per_kwh ?? 0,
    gas:    energy?.natural_gas_dollars_per_therm ?? 0,
    hvac:   labor?.hvac_multiplier ?? 1,
    plumb:  labor?.plumber_multiplier ?? 1,
    cold:   climate?.heat_pump_class === 'coldclimate',
  };
}).sort((a, b) => a.name.localeCompare(b.name));

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Heat Pump Water Heater Cost by State',
    description: 'Installed-cost estimates, retail electricity and gas prices, and HVAC/plumber labor multipliers for HPWHs in every U.S. state plus DC.',
  },
];
---
<Layout
  title="Heat Pump Water Heater Cost by State 2026"
  description="HPWH installed cost, retail electricity and gas prices, and HVAC/plumber labor multipliers for every U.S. state plus DC."
  active="/heat-pump-water-heater-cost-calculator/"
  ogImage="/assets/topic-images/heat-pump-water-heater-hero-photo.jpg"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'HPWH calculator', href: '/heat-pump-water-heater-cost-calculator/' },
    { name: 'By state', href: '/heat-pump-water-heater-cost-by-state/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump water heater</p>
    <h1 class="mt-1 text-3xl md:text-4xl">HPWH Cost by State</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      A hybrid heat pump water heater runs $2,200–$4,200 installed nationally for a 50-gallon unit, with local HVAC + plumber labor rates and the cost of a new 240V circuit shifting the band by state. Below: 51 state pages with calibrated ranges.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $2,200–$4,200 typical hybrid 50-gal; $1,700–$3,400 for 120V plug-in; $5,500–$12,000 for premium split systems. Federal 25C credit (which covered HPWHs to $2,000) expired Dec 31 2025.
    </p>
  </section>

  <section class="container-wide pb-10">
    <h2 class="text-xl">All 50 states + DC</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
          <tr>
            <th class="py-2 pr-3">State</th>
            <th class="py-2 pr-3 tabular-nums">Electricity</th>
            <th class="py-2 pr-3 tabular-nums">Natural gas</th>
            <th class="py-2 pr-3 tabular-nums">HVAC labor</th>
            <th class="py-2 pr-3 tabular-nums">Plumber labor</th>
            <th class="py-2 pr-3">Climate</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr class="border-b border-ink-100">
              <td class="py-2 pr-3"><a href={`/heat-pump-water-heater-cost-${r.code.toLowerCase()}/`} class="font-medium">{r.name}</a></td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.ecents.toFixed(1)}¢/kWh</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">${r.gas.toFixed(2)}/therm</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.hvac.toFixed(2)}×</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.plumb.toFixed(2)}×</td>
              <td class="py-2 pr-3">{r.cold ? <span class="badge-amber">Cold</span> : <span class="badge-green">Moderate</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide pb-12">
    <div class="card p-5">
      <h2 class="text-lg">Next steps</h2>
      <p class="mt-2 max-w-prose text-sm text-ink-700">
        Use the <a href="/heat-pump-water-heater-cost-calculator/" class="text-brand-700 font-medium">main calculator</a> for a planning-range cost calibrated to capacity, voltage, and install location. Want a city-level view? See <a href="/heat-pump-water-heater-cost-by-city/" class="text-brand-700 font-medium">HPWH cost by city</a> for the 100 largest U.S. metros. For background on UEF, install location, and brand comparison, read the <a href="/guides/heat-pump-water-heaters/" class="text-brand-700 font-medium">HPWH guide</a>.
      </p>
    </div>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
