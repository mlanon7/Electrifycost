---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import { ALL_CITIES, findStateLabor, findStateEnergy, stateName } from '@/lib/data';

const rows = ALL_CITIES.map(c => {
  const labor = findStateLabor(c.state);
  const energy = findStateEnergy(c.state);
  const hvac = labor?.hvac_multiplier ?? 1;
  const plumber = labor?.plumber_multiplier ?? 1;
  return {
    slug: c.slug,
    city: c.city,
    state: c.state,
    stName: stateName(c.state),
    blended: (hvac + plumber) / 2,
    ecents: energy?.electricity_cents_per_kwh ?? 0,
    rank: c.rank,
  };
}).sort((a, b) => a.rank - b.rank);

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Heat Pump Water Heater Cost by City',
    description: 'Heat pump water heater installed-cost estimates for the 100 largest U.S. cities, each calibrated to local labor rates and electricity prices.',
  },
];
---
<Layout
  title="Heat Pump Water Heater Cost by City 2026"
  description="HPWH installed cost for the 100 largest U.S. cities, calibrated to local HVAC + plumber labor and electricity prices. Houston, Phoenix, Chicago, and more."
  active="/heat-pump-water-heater-cost-calculator/"
  ogImage="/assets/topic-images/heat-pump-water-heater-hero-photo.jpg"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'HPWH calculator', href: '/heat-pump-water-heater-cost-calculator/' },
    { name: 'By city', href: '/heat-pump-water-heater-cost-by-city/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump water heaters</p>
    <h1 class="mt-1 text-3xl md:text-4xl">Heat Pump Water Heater Cost by City</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      Heat pump water heater installed cost for the 100 largest U.S. cities. Each city page is calibrated to its state's HVAC + plumber labor blend and retail electricity price. For a planning-range estimate tuned to your home, open any city below.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> a 50-gallon hybrid HPWH runs $2,200–$4,200 installed in most metros, higher in high-labor markets like San Francisco and New York. Operating cost is about 1/3 of a standard electric tank. Also see <a href="/heat-pump-water-heater-cost-by-state/" class="text-brand-700 hover:underline">HPWH cost by state</a>.
    </p>
  </section>

  <section class="container-wide pb-10">
    <h2 class="text-xl">100 largest U.S. cities</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
          <tr>
            <th class="py-2 pr-3">City</th>
            <th class="py-2 pr-3">State</th>
            <th class="py-2 pr-3 tabular-nums">Electricity</th>
            <th class="py-2 pr-3 tabular-nums">Labor blend</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr class="border-b border-ink-100">
              <td class="py-2 pr-3"><a href={`/heat-pump-water-heater-cost/${r.slug}/`} class="font-medium">{r.city}</a></td>
              <td class="py-2 pr-3 text-ink-700">{r.stName}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.ecents.toFixed(1)} cents/kWh</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.blended.toFixed(2)}x</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide pb-12">
    <div class="card p-5">
      <h2 class="text-lg">Next steps</h2>
      <p class="mt-2 max-w-prose text-sm text-ink-700">
        Use the <a href="/heat-pump-water-heater-cost-calculator/" class="text-brand-700 font-medium">main calculator</a> for a planning-range cost calibrated to capacity, voltage, and install location, or browse <a href="/heat-pump-water-heater-cost-by-state/" class="text-brand-700 font-medium">HPWH cost by state</a>. For background on UEF, install location, and brand comparison, read the <a href="/guides/heat-pump-water-heaters/" class="text-brand-700 font-medium">HPWH guide</a>.
      </p>
    </div>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
