---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import PanelCalculator from '@/components/PanelCalculator';
import {
  ALL_STATES,
  findStateEnergy,
  findStateLabor,
  findClimate,
  rebatePrograms,
} from '@/lib/data';
import { fmtUSD } from '@/lib/format';

export async function getStaticPaths() {
  return ALL_STATES.map(s => ({ params: { state: s.code.toLowerCase() } }));
}

const { state: stateParam } = Astro.params as { state: string };
const stateCode = (stateParam ?? '').toUpperCase();
// getStaticPaths enumerates every valid state, so meta is always defined at
// build time. The non-null assertion is safe here.
const meta = ALL_STATES.find(s => s.code === stateCode)!;
const stateName = meta.name;
const energy = findStateEnergy(stateCode);
const labor  = findStateLabor(stateCode);
const climate = findClimate(stateCode);

const stateRebates = rebatePrograms.filter(
  r => (r.module === 'panel' || r.module === '') &&
       (r.state === stateCode || r.scope === 'federal')
);

const isCold = climate?.heat_pump_class === 'coldclimate';
const electricityCents = energy?.electricity_cents_per_kwh ?? 0;
const gasPrice = energy?.natural_gas_dollars_per_therm ?? 0;
const oilPrice = energy?.heating_oil_dollars_per_gallon ?? 0;
const propanePrice = energy?.propane_dollars_per_gallon ?? 0;

const description = `100A-to-200A electrical panel upgrade cost in ${stateName}: state electrician labor ${labor?.electrician_multiplier?.toFixed(2) ?? 'n/a'}×, ~$${labor?.permit_avg ?? 300} permit, ${stateRebates.length} rebate programs.`;

const faq = [
  {
    q: `How much does a 100A to 200A panel upgrade cost in ${stateName}?`,
    a: `In ${stateName}, a 100A to 200A panel upgrade typically runs ${fmtUSD(1800 * (labor?.electrician_multiplier ?? 1))}–${fmtUSD(4500 * (labor?.electrician_multiplier ?? 1))} installed. The work includes a new 200A main breaker, meter base, service-entrance conductors, and utility coordination. Use the calculator above to refine for your existing panel and install difficulty.`,
  },
  {
    q: `Is a panel upgrade necessary for an EV charger or heat pump in ${stateName}?`,
    a: `Not always. NEC 220.83 load calculations frequently show a 100A panel handles a heat pump + EV charger + induction range if existing loads are modest. A smart load-management device ($500 to $1,500) often replaces a $4,000 upgrade by scheduling large loads so the home never exceeds the existing service capacity. ${stateName} licensed electricians can run the load calc for $100 to $300.`,
  },
  {
    q: `What permits and rebates apply in ${stateName}?`,
    a: `Permit fees in ${stateName} average about $${labor?.permit_avg ?? 300} for a residential service upgrade. The federal 25C credit expired Dec 31 2025 under OBBBA, so federal credits no longer apply to panel work placed in service in 2026. The calculator surfaces ${stateRebates.length} programs for ${stateName}.`,
  },
  {
    q: `How long does the work take in ${stateName}?`,
    a: 'A typical 100A to 200A service upgrade is a one-day job, but power is off for 4 to 8 hours during the cutover. If the utility has to replace the service drop or relocate the meter, the calendar can stretch to 2 to 3 weeks because the utility schedules its part separately. The utility-side work is usually free.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Electrical Panel Upgrade Cost Calculator — ${stateName}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title={`Panel Upgrade Cost in ${stateName} — 100A to 200A`}
  description={description}
  active="/electrical-panel-upgrade-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
>
  <section class="container-wide py-8 md:py-10">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{stateName}</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Panel Upgrade Cost in {stateName}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 md:text-base">
      Estimate the installed cost of a 100A→200A service upgrade, subpanel, or smart load-management device in {stateName}. Calibrated to local electrician labor ({labor?.electrician_multiplier?.toFixed(2) ?? '—'}× the U.S. average) and typical permit fees.
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Electrician labor</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{labor?.electrician_multiplier?.toFixed(2) ?? '—'}×</div>
        <div class="text-xs text-ink-500">vs. U.S. average (BLS)</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Permit fee</div>
        <div class="mt-1 text-base font-semibold text-ink-900">${labor?.permit_avg ?? 300}</div>
        <div class="text-xs text-ink-500">typical residential</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Electricity</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{electricityCents.toFixed(1)}¢/kWh</div>
        <div class="text-xs text-ink-500">EIA retail average</div>
      </div>
    </div>
  </section>

  <section class="container-wide pb-10">
    <PanelCalculator client:load initialState={stateCode} />
  </section>

  <section class="container-wide py-10">
    <h2 class="text-xl font-semibold text-ink-900">Panel-related rebates &amp; credits in {stateName}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="py-2 pr-3">Program</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Amount</th>
            <th class="py-2 pr-3">Expires</th>
          </tr>
        </thead>
        <tbody>
          {stateRebates.map(p => (
            <tr class="border-b border-ink-100 align-top">
              <td class="py-2 pr-3">
                <div class="font-medium text-ink-900">
                  {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                </div>
                {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.scope === 'federal' ? 'Federal' : p.scope === 'state' ? 'State' : 'Utility'} · {p.incentive_type === 'tax_credit' ? 'Credit' : 'Rebate'}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-900">
                {p.percent > 0 ? `${p.percent}% up to $${p.cap.toLocaleString()}` :
                  p.amount_low === p.amount_high ? `$${p.amount_high.toLocaleString()}` :
                  `$${p.amount_low.toLocaleString()}–$${p.amount_high.toLocaleString()}`}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.expiration_date || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Panel upgrade cost by state</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {ALL_STATES.map(s => (
        <li><a href={`/electrical-panel-upgrade-cost-${s.code.toLowerCase()}/`}>{s.name}</a></li>
      ))}
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
