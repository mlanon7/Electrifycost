---
import Layout from '@/components/Layout.astro';
---
<Layout
  title="Page not found — ElectrifyCost"
  description="The page you were looking for doesn't exist. Use the calculators to estimate home electrification costs."
>
  <section class="container-tight py-20 text-center">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">404</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">Page not found</h1>
    <p class="mt-3 text-ink-700">The page you're looking for isn't here. Try one of the calculators:</p>
    <ul class="mt-6 inline-flex flex-col gap-2 text-sm">
      <li><a href="/heat-pump-cost-calculator/">Heat pump cost calculator</a></li>
      <li><a href="/electrical-panel-upgrade-cost-calculator/">Electrical panel upgrade cost calculator</a></li>
      <li><a href="/ev-charger-installation-cost-calculator/">EV charger installation cost calculator</a></li>
      <li><a href="/heat-pump-water-heater-cost-calculator/">Heat pump water heater cost calculator</a></li>
      <li><a href="/induction-stove-cost-calculator/">Induction stove cost calculator</a></li>
    </ul>
  </section>
</Layout>
