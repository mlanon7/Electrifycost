---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HeatPumpCalculator from '@/components/HeatPumpCalculator';

const faq = [
  {
    q: 'How much does a 3-ton heat pump cost installed?',
    a: 'A 3-ton (36,000 BTU/hr) ducted central heat pump runs $8,000 to $16,000 installed nationally, per NREL benchmark data and 2026 installer surveys. A 3-ton system suits roughly 1,500 to 2,000 sqft in a moderate climate. Cold-climate (NEEP-listed) equipment adds $1,500 to $3,500. State labor rates shift the band — California, Hawaii, and the Northeast run highest.',
  },
  {
    q: 'What size home does a 3-ton heat pump heat and cool?',
    a: 'A 3-ton unit is sized for about 1,500 to 2,000 sqft in a moderate climate (IECC zones 3 to 5), assuming average insulation. Tighter, newer homes may be fine at 2.5 tons for the same footprint; older, leaky homes may need 3.5 tons. A Manual J load calculation by a licensed contractor is the proper sizing method — the per-sqft rule of thumb is a starting point, not a spec.',
  },
  {
    q: 'Is 3 tons the most common residential heat pump size?',
    a: 'Yes. The 3-ton size covers the largest share of U.S. single-family homes, which is why it is the most-quoted residential heat pump capacity. If your home is meaningfully larger than 2,000 sqft or has poor insulation, see the 4-ton and 5-ton pages; for smaller homes, see the 2-ton page.',
  },
  {
    q: 'What rebates apply to a 3-ton heat pump?',
    a: 'The federal 25C credit expired Dec 31 2025 under OBBBA. State and utility programs plus DOE Home Energy Rebates (where launched) still apply and are not capacity-dependent — they key off equipment efficiency and household income, not tonnage. Use the calculator above to see programs for your state.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '3-Ton Heat Pump Cost',
    description: 'Planning-range installed cost for a 3-ton (36,000 BTU/hr) heat pump — the most common residential size, suited to 1,500-2,000 sqft.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  title="3-Ton Heat Pump Cost 2026 — Installed Price by Home & State"
  description="A 3-ton heat pump runs $8,000-$16,000 installed (most common residential size, 1,500-2,000 sqft). State-calibrated estimate, sizing, and rebates."
  active="/heat-pump-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/heat-pump-hero-photo.png"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump calculator', href: '/heat-pump-cost-calculator/' },
    { name: '3-ton', href: '/heat-pump-cost-3-ton/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump · 3-ton</p>
    <h1 class="mt-1 text-3xl md:text-4xl">3-Ton Heat Pump Cost</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      A 3-ton (36,000 BTU/hr) heat pump is the most common residential size, suited to roughly 1,500-2,000 sqft. Plan-level installed cost, sizing guidance, and the rebates that still apply in 2026.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $8,000-$16,000 installed for a ducted 3-ton; cold-climate equipment adds $1,500-$3,500; high-cost states (CA, HI, NY, MA) run toward the top. Refine by state and home below.
    </p>
  </section>

  <section class="container-wide pb-10"><HeatPumpCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump cost by size</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
      <li><a href="/heat-pump-cost-1-5-ton/">1.5-ton (~600-900 sqft) →</a></li>
      <li><a href="/heat-pump-cost-2-ton/">2-ton (~900-1,300 sqft) →</a></li>
      <li><a href="/heat-pump-cost-4-ton/">4-ton (~2,000-2,600 sqft) →</a></li>
      <li><a href="/heat-pump-cost-5-ton/">5-ton (~2,600-3,200 sqft) →</a></li>
      <li><a href="/heat-pump-cost-2000-sqft/">By home size (sqft) →</a></li>
      <li><a href="/heat-pump-cost-by-state/">By state →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
