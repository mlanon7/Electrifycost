---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HeatPumpCalculator from '@/components/HeatPumpCalculator';
import {
  ALL_STATES,
  findStateEnergy,
  findStateLabor,
  findClimate,
  rebatePrograms,
} from '@/lib/data';
import { fmtUSD } from '@/lib/format';

export async function getStaticPaths() {
  return ALL_STATES.map(s => ({ params: { state: s.code.toLowerCase() } }));
}

const { state: stateParam } = Astro.params as { state: string };
const stateCode = (stateParam ?? '').toUpperCase();
// getStaticPaths enumerates every valid state, so meta is always defined at
// build time. The non-null assertion is safe here.
const meta = ALL_STATES.find(s => s.code === stateCode)!;
const stateName = meta.name;
const energy = findStateEnergy(stateCode);
const labor  = findStateLabor(stateCode);
const climate = findClimate(stateCode);

const stateRebates = rebatePrograms.filter(
  r => (r.module === 'heat_pump' || r.module === '') &&
       (r.state === stateCode || r.scope === 'federal')
);

const isCold = climate?.heat_pump_class === 'coldclimate';
const electricityCents = energy?.electricity_cents_per_kwh ?? 0;
const gasPrice = energy?.natural_gas_dollars_per_therm ?? 0;
const oilPrice = energy?.heating_oil_dollars_per_gallon ?? 0;
const propanePrice = energy?.propane_dollars_per_gallon ?? 0;

const description = `Estimate the installed cost of a heat pump in ${stateName} (${stateCode}). State labor multiplier ${labor?.electrician_multiplier?.toFixed(2) ?? 'n/a'}, electricity ${electricityCents.toFixed(1)}¢/kWh, ${stateRebates.length} applicable incentive programs.`;

const faq = [
  {
    q: `How much does a heat pump cost in ${stateName}?`,
    a: `In ${stateName}, a typical ducted central heat pump runs ${labor ? fmtUSD(7500 * labor.hvac_multiplier) : '$7,500'}–${labor ? fmtUSD(20000 * labor.hvac_multiplier) : '$20,000'} installed. Cold-climate equipment runs higher. Use the calculator above to refine for your home size, panel, and ductwork.`,
  },
  {
    q: `Is a heat pump worth it in ${stateName}?`,
    a: isCold
      ? `${stateName} is in a cold climate zone (${climate?.iecc_zone ?? '—'}, ${climate?.heating_degree_days?.toLocaleString() ?? '—'} HDD). A cold-climate-rated or dual-fuel heat pump is the most reliable choice. Vs. heating oil at ~$${oilPrice.toFixed(2)}/gal, savings are typically substantial; vs. cheap natural gas, savings are smaller but still positive in most cases.`
      : `${stateName} is in a moderate climate zone (${climate?.iecc_zone ?? '—'}, ${climate?.heating_degree_days?.toLocaleString() ?? '—'} HDD). Standard air-source heat pumps work well year-round. Operating-cost change vs. your current fuel depends on local electricity (${electricityCents.toFixed(1)}¢/kWh) vs. gas (${gasPrice ? '$'+gasPrice.toFixed(2)+'/therm' : 'n/a'}).`,
  },
  {
    q: `What rebates are available for a heat pump in ${stateName}?`,
    a: `In 2026 the federal Energy Efficient Home Improvement Credit (25C) no longer applies — it was terminated by OBBBA for systems placed in service after Dec 31 2025. ${stateName} homeowners can still combine applicable state programs and DOE Home Energy Rebates where the state has launched the program. The calculator surfaces ${stateRebates.length} programs for your state and clearly separates confirmed credits from potential ones (e.g. HEEHRA in prelaunch states).`,
  },
  {
    q: `Do I need a panel upgrade for a heat pump in ${stateName}?`,
    a: 'Not always. A 200A panel is usually fine. A 100A panel often works after a load calculation. A 60A service almost always needs an upgrade. The calculator above includes a panel-risk verdict for your selection.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Heat Pump Cost Calculator — ${stateName}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title={`Heat Pump Cost in ${stateName} — Price & Rebates`}
  description={description}
  active="/heat-pump-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump by state', href: '/heat-pump-cost-by-state/' },
    { name: stateName, href: `/heat-pump-cost-${stateCode.toLowerCase()}/` },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{stateName}</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Heat Pump Cost in {stateName}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 md:text-base">
      Estimate the installed cost, applicable rebates, and operating-cost change for a heat pump in {stateName}. Calibrated to local labor rates ({labor?.electrician_multiplier?.toFixed(2) ?? '—'}× HVAC multiplier), retail electricity ({electricityCents.toFixed(1)}¢/kWh), and {climate?.heat_pump_class === 'coldclimate' ? 'cold' : 'standard'} climate.
    </p>
    <p class="mt-3 max-w-2xl text-xs text-ink-600">
      <strong>Planning range, not a contractor quote.</strong> Verify state and utility programs with the linked administrator before claiming — caps, eligibility, and timelines change.
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-4">
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Climate zone</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{climate?.iecc_zone ?? '—'}</div>
        <div class="text-xs text-ink-600">{climate?.heating_degree_days?.toLocaleString() ?? '—'} HDD</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Electricity</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{electricityCents.toFixed(1)}¢/kWh</div>
        <div class="text-xs text-ink-600">EIA retail average</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Natural gas</div>
        <div class="mt-1 text-base font-semibold text-ink-900">${gasPrice.toFixed(2)}/therm</div>
        <div class="text-xs text-ink-600">if available</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-600">Heat pump class</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{isCold ? 'Cold-climate' : 'Standard'}</div>
        <div class="text-xs text-ink-600">recommended</div>
      </div>
    </div>
  </section>

  <section class="container-wide pb-10">
    <HeatPumpCalculator client:load initialState={stateCode} />
  </section>

  <section class="container-wide py-10">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump rebates &amp; credits in {stateName}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
          <tr>
            <th class="py-2 pr-3">Program</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Amount</th>
            <th class="py-2 pr-3">Expires</th>
          </tr>
        </thead>
        <tbody>
          {stateRebates.map(p => (
            <tr class="border-b border-ink-100 align-top">
              <td class="py-2 pr-3">
                <div class="font-medium text-ink-900">
                  {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                </div>
                {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.scope === 'federal' ? 'Federal' : p.scope === 'state' ? 'State' : 'Utility'} · {p.incentive_type === 'tax_credit' ? 'Credit' : 'Rebate'}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-900">
                {p.percent > 0 ? `${p.percent}% up to $${p.cap.toLocaleString()}` :
                  p.amount_low === p.amount_high ? `$${p.amount_high.toLocaleString()}` :
                  `$${p.amount_low.toLocaleString()}–$${p.amount_high.toLocaleString()}`}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.expiration_date || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Heat pump cost by state</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {ALL_STATES.map(s => (
        <li><a href={`/heat-pump-cost-${s.code.toLowerCase()}/`}>{s.name}</a></li>
      ))}
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
