---
import Layout from '@/components/Layout.astro';
import glossaryData from '@/data/glossary.json';

interface Term {
  term: string;
  expansion?: string;
  definition: string;
  category: string;
}

const terms = Object.entries(glossaryData as Record<string, Term>);

const categoryOrder: { key: string; title: string }[] = [
  { key: 'incentive',  title: 'Tax credits & rebates' },
  { key: 'electrical', title: 'Electrical & panels' },
  { key: 'heating',    title: 'Heating & cooling' },
  { key: 'water',      title: 'Water heating' },
  { key: 'kitchen',    title: 'Kitchen' },
  { key: 'ev',         title: 'EV charging' },
  { key: 'general',    title: 'General' },
];

function bucket(cat: string) {
  return terms
    .filter(([, t]) => t.category === cat)
    .sort((a, b) => a[1].term.localeCompare(b[1].term));
}

const schemaJsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Home Electrification Glossary', description: 'Glossary of terms used across home electrification, HVAC, solar, EV, and rebate programs.' };
---
<Layout
  title="Home Electrification Glossary — AFUE, COP, HSPF2, NEMA 14-50, 25C, HEEHRA"
  description="Plain-English definitions of heat pump, HPWH, EV charger, electrical panel, and induction-stove terminology used in our cost calculators."
  active="/glossary/"
  schemaJsonLd={schemaJsonLd}
>
  <section class="container-tight py-10 md:py-14">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Glossary</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">Home electrification glossary</h1>
    <p class="mt-3 max-w-prose text-ink-700">
      Every contractor uses jargon. Every quote has acronyms. This page translates the {terms.length} most common ones plainly. Bookmark it — you'll want it open while reading bids.
    </p>

    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      {categoryOrder.map(c => (
        <a href={`#${c.key}`} class="rounded-full border border-ink-200 px-3 py-1 text-ink-700 no-underline hover:bg-ink-100">{c.title}</a>
      ))}
    </div>

    {categoryOrder.map(c => {
      const items = bucket(c.key);
      if (items.length === 0) return null;
      return (
        <div id={c.key} class="mt-10 scroll-mt-20">
          <h2 class="text-xl font-semibold text-ink-900">{c.title}</h2>
          <dl class="mt-4 grid gap-3 sm:grid-cols-2">
            {items.map(([id, t]) => (
              <div class="card p-4">
                <dt class="text-sm font-semibold text-ink-900" id={id}>
                  {t.term}
                  {t.expansion && <span class="ml-1.5 text-xs font-normal text-ink-500">({t.expansion})</span>}
                </dt>
                <dd class="mt-1.5 text-sm text-ink-700">{t.definition}</dd>
              </div>
            ))}
          </dl>
        </div>
      );
    })}

    <p class="mt-12 text-xs text-ink-500">
      Spotted something we should add or correct? Sources for our definitions are catalogued on the <a href="/sources/">sources page</a>.
    </p>
  </section>
</Layout>
