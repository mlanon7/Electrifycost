---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HeatPumpCalculator from '@/components/HeatPumpCalculator';

const faq = [
  {
    q: 'What size heat pump does a 2,500 sqft home need?',
    a: 'A 2,500 sqft home typically needs a 3-ton (36,000 BTU/hr) heat pump. Larger or drafty homes may need 3.5-4 tons. Multi-zone designs (separate first-floor / second-floor systems) are common at this size to handle thermal differences between floors. A Manual J load calculation is essential at this size — over-sizing wastes thousands.',
  },
  {
    q: 'How much does a heat pump cost for a 2,500 sqft home?',
    a: 'A 3-ton ducted central heat pump install typically runs $8,500–$20,000 installed nationally. A multi-zone system (two 1.5-2 ton systems) runs $12,000–$28,000. Cold-climate equipment adds $2,000–$4,500. State labor variance can shift these +/- 30% in CA, HI, and the NYC metro.',
  },
  {
    q: 'Should I use one system or two for 2,500 sqft?',
    a: 'Depends on the floor plan. Two-story homes often benefit from two smaller systems (one per floor) — better zoning, more accurate sizing per zone, less duct loss. Single-story homes are usually fine on one larger system. The cost premium for two systems is typically $3,000–$7,000 above a single equivalent-capacity system but pays back via comfort and equipment life.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Heat Pump Cost for 2,500 sqft Home',
    description: 'Planning-range installed cost for a 3-ton heat pump in a 2,500 sqft home, including multi-zone vs single-system trade-off.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title="Heat Pump Cost for 2,500 sqft Home 2026"
  description="Plan-level cost for a 3-ton heat pump in a 2,500 sqft home. Single-system vs multi-zone, sizing, cold-climate add-ons."
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/heat-pump-hero-photo.png"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump calculator', href: '/heat-pump-cost-calculator/' },
    { name: '2,500 sqft', href: '/heat-pump-cost-2500-sqft/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Heat pump · 2,500 sqft</p>
    <h1 class="mt-1 text-3xl md:text-4xl">Heat Pump Cost for a 2,500 sqft Home</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      A 2,500 sqft home typically needs a 3-ton heat pump. Plan-level installed cost ranges and the single-system vs multi-zone trade-off.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $8,500–$20,000 for ducted 3-ton; $12,000–$28,000 for multi-zone two-system design; cold-climate adds $2,000–$4,500.
    </p>
  </section>

  <section class="container-wide pb-10"><HeatPumpCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">By square footage</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
      <li><a href="/heat-pump-cost-1000-sqft/">1,000 sqft (1-1.5 ton) →</a></li>
      <li><a href="/heat-pump-cost-1500-sqft/">1,500 sqft (2 ton) →</a></li>
      <li><a href="/heat-pump-cost-2000-sqft/">2,000 sqft (2.5 ton) →</a></li>
      <li><a href="/heat-pump-cost-3000-sqft/">3,000 sqft (3.5-4 ton) →</a></li>
      <li><a href="/heat-pump-cost-calculator/">Main calculator →</a></li>
      <li><a href="/heat-pump-cost-by-state/">By state →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
