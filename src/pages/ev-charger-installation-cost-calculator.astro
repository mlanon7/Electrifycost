---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import AffiliateModule from '@/components/AffiliateModule.astro';
import EvChargerCalculator from '@/components/EvChargerCalculator';

const faq = [
  {
    q: 'How much does a Level 2 EV charger installation cost?',
    a: 'Most Level 2 home installs land between $800 and $2,800, per NREL benchmark data and 2026 installer surveys, when the panel has capacity and the run is short. Long conduit runs, detached garages with trenching, or panel upgrades push the total higher.',
  },
  {
    q: 'Should I get a hardwired or plug-in (NEMA 14-50) Level 2 charger?',
    a: 'Hardwired chargers can support continuous 48A charging and are required by code for some models above 40A continuous. The underlying NEC rule is the 80% continuous-load derating in NEC 625.41 / 210.20(B). Plug-in via a NEMA 14-50 outlet is simpler to install and typically caps at 32–40A continuous. Either is fine for most owners; pick based on your charger model spec, the SAE J1772 / NACS connector, and how fast you want to charge.',
  },
  {
    q: 'Do I need a panel upgrade for an EV charger?',
    a: 'Not always. A 200A panel is usually fine. A 100A panel often works after a NEC 220.83 load calculation, especially when paired with smart load management. A 60A service almost always needs an upgrade.',
  },
  {
    q: 'Is there a federal tax credit for home EV chargers?',
    a: 'No — the federal 30C Alternative Fuel Vehicle Refueling Property Credit (30% of cost up to $1,000, eligible census tracts only) expired for property placed in service after June 30, 2026. The OBBBA legislation (signed July 4, 2025) accelerated the prior 2032 sunset to that date. Chargers placed in service on or before June 30, 2026 can still be claimed on that tax-year return via Form 8911: https://www.irs.gov/instructions/i8911. Background: https://www.irs.gov/credits-deductions/alternative-fuel-vehicle-refueling-property-credit. Some state and utility rebates remain — see the rebates page.',
  },
  {
    q: 'How do I check if my address was in an eligible 30C census tract?',
    a: 'Tract eligibility now matters only for chargers placed in service on or before June 30, 2026 — the 30C credit expired after that date. If your install qualified on timing, use the DOE / IRS eligibility tool (https://www.energy.gov/vehicles) to confirm the tract before filing Form 8911. The tract had to qualify as either a low-income community or a non-urban tract; eligibility is binary.',
  },
  {
    q: 'What is the right amperage for my install?',
    a: '40A or 48A continuous (50A or 60A breaker) is the sweet spot for most modern EVs and chargers. Going beyond 48A requires hardwiring per NEC 625; below 30A leaves charging speed on the table for owners who drive a lot.',
  },
  {
    q: 'J1772, Tesla NACS, or CCS — which connector should my home charger use?',
    a: 'Since 2024–2025, the U.S. industry is transitioning to NACS (the connector pioneered by Tesla, formally SAE J3400). Most new EVs sold in 2025–2026 either ship with NACS or include a J1772-to-NACS adapter. For home installs, buy a charger with the J1772 (universal) connector and use the adapter that came with your car, OR buy a NACS-native charger if you only own Teslas. Avoid CCS — that connector is for DC fast charging, not Level 2 home use. Reference: SAE J3400 standard, https://www.sae.org/standards/content/j3400/.',
  },
  {
    q: 'Do I need an outdoor-rated charger for a driveway or garage install?',
    a: 'Yes — any charger mounted outside or in an unconditioned garage needs at least a NEMA 3R rating (rain-tight). NEMA 4 (watertight) or NEMA 4X (corrosion-resistant) is better for coastal or heavy-rain areas. Indoor-only chargers in conditioned spaces can be NEMA 1. Most modern Level 2 chargers (ChargePoint, Wallbox Pulsar Plus, Tesla Wall Connector, Emporia) ship NEMA 3R or 4 by default — confirm before buying. Reference: NEMA ratings explained at https://www.nema.org/standards.',
  },
  {
    q: 'How long does a typical Level 2 install take?',
    a: 'A simple side-of-house install with panel capacity available and a ~10 ft conduit run takes 2–4 hours. Long runs (30–50 ft) or detached garages with trenching push install time to 6–8 hours. Panel upgrades, when needed, add a full day plus utility coordination. Permit + inspection are typically separate appointments and add 1–3 weeks of calendar time even when the work itself is quick.',
  },
  {
    q: 'Are smart / WiFi-connected chargers worth the extra cost?',
    a: 'For most owners, basic Level 2 (dumb) hardware is sufficient — your car schedules charging. WiFi/smart chargers add ~$200–$400 to hardware cost, per NREL benchmark data, and earn that back in three scenarios: (1) you have time-of-use electricity rates and want load shifting controlled at the charger, (2) you want to share charging across a household or duty cycle, or (3) your utility offers a managed-charging rebate that requires a connected device. Otherwise, optional.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'EV Charger Installation Cost Calculator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Free planning-range calculator for Level 2 EV charger installs at home, including panel work, trenching, and state/utility rebates.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title="EV Charger Installation Cost Calculator 2026"
  description="Estimate the installed cost of a Level 2 EV charger at home, with panel-load awareness, trenching, and state/utility rebates applied."
  active="/ev-charger-installation-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/ev-charger-hero-photo.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'EV charger installation calculator', href: '/ev-charger-installation-cost-calculator/' },
  ]}
>
  <section class="container-wide grid gap-6 py-8 md:grid-cols-[minmax(0,1fr)_420px] md:items-center md:py-10">
    <div>
      <p class="eyebrow">EV charger</p>
      <h1 class="mt-1 text-3xl md:text-4xl">EV Charger Installation Cost Calculator</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
        Plan-level installed cost for a Level 2 home charger — hardwired or plug-in, with optional trenching and panel work. Includes state/utility rebates; the federal 30C credit expired for chargers placed in service after June 30, 2026.
      </p>
      <p class="mt-3 rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
        <strong>Quick answer:</strong> a typical Level 2 home charger install runs $1,000–$2,800 hardwired with a short conduit run. Trenching to a detached garage pushes that to $3,000–$8,000. The federal 30C credit (30% up to $1,000) expired for chargers placed in service after June 30, 2026.
      </p>
    </div>
    <picture>
        <source srcset="/assets/topic-images/ev-charger-hero-photo.avif" type="image/avif" />
        <source srcset="/assets/topic-images/ev-charger-hero-photo.webp" type="image/webp" />
        <img  src="/assets/topic-images/ev-charger-hero-photo.webp"
      alt="Home EV charger installed in a residential garage"
      width="1200" height="675"
      class="w-full rounded-lg border border-ink-200 bg-white shadow-card"
      loading="eager" decoding="async"
     />
      </picture>
  </section>

  <section class="container-wide pb-10"><EvChargerCalculator client:load /></section>

  <AffiliateDisclosure />
  <AffiliateModule kind="ev_charger" />

  <section class="container-wide py-8 border-t border-ink-100">
    <div class="max-w-prose">
      <h2 class="text-xl font-semibold text-ink-900">New to home EV charging?</h2>
      <p class="mt-2 text-sm text-ink-700">
        The box on your wall is technically an EVSE — the real charger lives inside your car. Level 1 (120V) adds 3–5 mi/hr; Level 2 (240V, 16–80A) is what 80% of EV owners actually want, adding 20–45 mi/hr. NEC 625.41 sizes the circuit at 125% of continuous current (so a 48A EVSE needs a 60A breaker). You probably don't need a panel upgrade — a load-management device at $500–$1,500 often replaces a $4,000 service upgrade. The federal 30C credit (30% up to $1,000) expired for chargers placed in service after June 30, 2026; state and utility rebates are now the main incentives.
      </p>
      <p class="mt-3 text-sm">
        <a href="/guides/ev-chargers/" class="font-medium text-brand-700">Read the full guide <span aria-hidden="true">→</span></a>
        <span class="ml-2 text-ink-600">7-min read · charger levels · NEC sizing · NACS connectors · 30C credit · load management</span>
      </p>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-8">
    <h2 class="text-xl font-semibold text-ink-900">EV charger cost by brand</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3">
      <li><a href="/chargepoint-ev-charger-installation-cost/">ChargePoint <span aria-hidden="true">→</span></a></li>
      <li><a href="/wallbox-ev-charger-installation-cost/">Wallbox <span aria-hidden="true">→</span></a></li>
      <li><a href="/tesla-ev-charger-installation-cost/">Tesla <span aria-hidden="true">→</span></a></li>
      <li><a href="/emporia-ev-charger-installation-cost/">Emporia <span aria-hidden="true">→</span></a></li>
      <li><a href="/grizzl-e-ev-charger-installation-cost/">Grizzl-E <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Related calculators</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
      <li><a href="/electrical-panel-upgrade-cost-calculator/">Electrical panel upgrade cost calculator <span aria-hidden="true">→</span></a></li>
      <li><a href="/heat-pump-cost-calculator/">Heat pump cost calculator <span aria-hidden="true">→</span></a></li>
      <li><a href="/heat-pump-water-heater-cost-calculator/">Heat pump water heater cost calculator <span aria-hidden="true">→</span></a></li>
      <li><a href="/induction-stove-cost-calculator/">Induction stove cost calculator <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
