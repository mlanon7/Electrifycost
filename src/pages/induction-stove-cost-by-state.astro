---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import { ALL_STATES, findStateEnergy, findStateLabor } from '@/lib/data';

const rows = ALL_STATES.map(s => {
  const energy = findStateEnergy(s.code);
  const labor  = findStateLabor(s.code);
  return {
    code: s.code,
    name: s.name,
    ecents: energy?.electricity_cents_per_kwh ?? 0,
    gas:    energy?.natural_gas_dollars_per_therm ?? 0,
    elec:   labor?.electrician_multiplier ?? 1,
  };
}).sort((a, b) => a.name.localeCompare(b.name));

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Induction Stove Cost by State',
    description: 'Installed-cost estimates, electricity and gas prices, and electrician labor multipliers for induction stoves in every U.S. state plus DC.',
  },
];
---
<Layout
  title="Induction Stove Cost by State 2026"
  description="Induction range and cooktop installed cost, retail electricity and gas prices, and electrician labor multipliers for every U.S. state plus DC."
  active="/induction-stove-cost-calculator/"
  ogImage="/assets/topic-images/induction-stove-hero-photo.png"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Induction calculator', href: '/induction-stove-cost-calculator/' },
    { name: 'By state', href: '/induction-stove-cost-by-state/' },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Induction stove</p>
    <h1 class="mt-1 text-3xl md:text-4xl">Induction Stove Cost by State</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      Basic 30-inch induction range install runs $1,500–$3,500 nationally; a new 240V circuit adds $400–$1,300 if needed, and capping the existing gas line adds $150–$450. Below: 51 state pages with calibrated ranges.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> $1,500–$3,500 typical install, $2,800–$6,500 for premium; +$400–$1,300 for new 240V circuit; +$150–$450 to cap gas. Federal 25C does NOT cover stoves; HEEHRA covers up to $840 for income-qualified households.
    </p>
  </section>

  <section class="container-wide pb-10">
    <h2 class="text-xl">All 50 states + DC</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="py-2 pr-3">State</th>
            <th class="py-2 pr-3 tabular-nums">Electricity</th>
            <th class="py-2 pr-3 tabular-nums">Natural gas</th>
            <th class="py-2 pr-3 tabular-nums">Electrician labor</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr class="border-b border-ink-100">
              <td class="py-2 pr-3"><a href={`/induction-stove-cost-${r.code.toLowerCase()}/`} class="font-medium">{r.name}</a></td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.ecents.toFixed(1)}¢/kWh</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">${r.gas.toFixed(2)}/therm</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.elec.toFixed(2)}×</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide pb-12">
    <div class="card p-5">
      <h2 class="text-lg">Next steps</h2>
      <p class="mt-2 max-w-prose text-sm text-ink-700">
        Use the <a href="/induction-stove-cost-calculator/" class="text-brand-700 font-medium">main calculator</a> for a planning-range cost calibrated to range vs. cooktop vs. portable, your panel size, and starter cookware. For background on IAQ benefits, brand picks, and the magnet test, read the <a href="/guides/induction-cooking/" class="text-brand-700 font-medium">induction cooking guide</a>.
      </p>
    </div>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
