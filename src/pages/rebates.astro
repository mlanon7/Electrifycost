---
import Layout from '@/components/Layout.astro';
import { rebatePrograms } from '@/lib/data';

const federal = rebatePrograms.filter(r => r.scope === 'federal');
const state = rebatePrograms.filter(r => r.scope === 'state');
const utility = rebatePrograms.filter(r => r.scope === 'utility');

function formatAmount(low: number, mid: number, high: number, percent: number, cap: number) {
  if (percent > 0) {
    return `${percent}% of cost up to $${cap.toLocaleString()}`;
  }
  if (low === 0 && mid === 0 && high === 0) return 'Varies';
  if (low === high) return `$${low.toLocaleString()}`;
  return `$${low.toLocaleString()} – $${high.toLocaleString()}`;
}

const schemaJsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Home Electrification Rebates Directory', description: 'Federal and state rebate programs for heat pumps, solar, batteries, EV chargers, water heaters, induction, and panels.' };
---
<Layout
  title="Home Electrification Rebates & Tax Credits 2026"
  description="Federal, state, and utility rebates and tax credits for heat pumps, EV chargers, electrical panel upgrades, heat pump water heaters, and induction stoves."
  active="/rebates/"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Rebates & credits', href: '/rebates/' },
  ]}
>
  <section class="container-tight py-10 md:py-14">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Rebates &amp; tax credits</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Home Electrification Rebates &amp; Tax Credits
    </h1>
    <p class="mt-3 max-w-prose text-ink-700">
      A round-up of the federal credits, state programs, and representative utility rebates we apply in our calculators. Always verify current program rules with the administrator — eligibility, equipment lists, and amounts change.
    </p>

    {[
      { title: 'Federal credits & rebates', list: federal },
      { title: 'State programs', list: state },
      { title: 'Utility programs (representative)', list: utility },
    ].map(group => (
      <div class="mt-10">
        <h2 class="text-xl font-semibold text-ink-900">{group.title}</h2>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
              <tr>
                <th class="py-2 pr-3">Program</th>
                <th class="py-2 pr-3">Module</th>
                <th class="py-2 pr-3">Type</th>
                <th class="py-2 pr-3">Amount</th>
                <th class="py-2 pr-3">Expires</th>
                <th class="py-2 pr-3">Reviewed</th>
              </tr>
            </thead>
            <tbody>
              {group.list.map(p => (
                <tr class="border-b border-ink-100 align-top">
                  <td class="py-2 pr-3">
                    <div class="font-medium text-ink-900">
                      {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                    </div>
                    {p.notes && <div class="text-xs text-ink-600">{p.notes}</div>}
                    {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
                  </td>
                  <td class="py-2 pr-3 text-ink-700">{p.module || '—'}</td>
                  <td class="py-2 pr-3 text-ink-700">{p.incentive_type === 'tax_credit' ? 'Tax credit' : 'Rebate'}</td>
                  <td class="py-2 pr-3 tabular-nums text-ink-900">{formatAmount(p.amount_low, p.amount_mid, p.amount_high, p.percent, p.cap)}</td>
                  <td class="py-2 pr-3 text-ink-700">{p.expiration_date || '—'}</td>
                  <td class="py-2 pr-3 text-ink-600">{p.last_reviewed}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <p class="mt-10 text-xs text-ink-600">
      This list is not exhaustive. Many cities and utilities run additional programs. OBBBA terminated both the Energy Efficient Home Improvement Credit (25C — heat pumps, HPWH, panel, insulation, windows) AND the Residential Clean Energy Credit (25D — solar, battery, geothermal) for property placed in service after December 31, 2025. The Clean Vehicle Credits (30D new, 25E used) ended for vehicles acquired after September 30, 2025. Rows marked <span class="font-medium text-ink-700">expired</span> are kept for historical reference and do not reduce 2026-forward estimates. The Alternative Fuel Vehicle Refueling Property Credit (30C) still applies to qualifying property placed in service through June 30, 2026 with eligible-census-tract requirements. DOE Home Energy Rebates roll out state-by-state — see the <a href="/methodology/">methodology page</a> for our current rollout snapshot.
    </p>
  </section>
</Layout>
