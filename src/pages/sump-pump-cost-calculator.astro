---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import SumpPumpCalculator from '@/components/SumpPumpCalculator';

const faq = [
  { q: 'How much does a sump pump cost installed?',
    a: 'Basic primary 1/3 HP: $430–$1,030. Heavy-duty 1/2 HP: $580–$1,450. Battery backup only (DC, add to existing): $450–$1,350. Combo primary + battery backup: $900–$2,500. Water-powered backup: $430–$1,400. Smart WiFi combo with monitoring: $1,300–$3,300.' },
  { q: 'Do I need a battery backup?',
    a: 'If your basement is finished, has valuable contents, or you live in an area with frequent storms or outages, yes. The most common sump-pump failure mode is the same storm that floods your basement also knocks out grid power. A DC battery backup runs 4-8 hours of continuous pumping or 24-72 hours of intermittent pumping. Battery replacement every 4-5 years.' },
  { q: 'Battery backup vs water-powered backup?',
    a: 'Battery backup: works during long outages but battery degrades over time and needs replacement. Water-powered: uses municipal water pressure (no battery), works as long as city water flows, but wastes ~1 gallon of city water per 2 gallons pumped — and only works if you&rsquo;re on city water (not well). For most homeowners, battery backup is the safer choice.' },
  { q: 'How much does a sump pump battery backup cost?',
    a: 'A DC battery backup added to an existing primary pump runs $450–$1,350 installed (the backup pump, controller, battery, and labor). A new combo system — primary pump plus integrated battery backup — runs $900–$2,500 installed. A smart WiFi combo with phone alerts and self-testing runs $1,300–$3,300. The battery itself is $150–$400 and is replaced every 4–5 years; budget that as an ongoing cost.' },
  { q: 'How long does a sump pump battery backup run during a power outage?',
    a: 'A typical AGM deep-cycle battery backup pumps for roughly 4–8 hours of continuous run, or 24–72 hours of intermittent cycling (the realistic storm scenario where the pump runs a minute every few minutes). Runtime depends on battery amp-hours, pump draw, and how often the float switch trips. Lithium (LiFePO4) backups cost more but hold capacity longer and tolerate more charge cycles.' },
  { q: 'What should I look for in a battery backup sump pump?',
    a: 'Prioritize: (1) adequate battery amp-hours for your outage risk, (2) a maintenance-free AGM or lithium battery over flooded lead-acid, (3) a controller with low-battery and high-water alarms, (4) WiFi monitoring if the basement is finished or you travel, and (5) a pump GPH rating that matches your pit&rsquo;s inflow. The backup pump should be sized close to your primary so it can keep up during a real storm.' },
];

const schemaJsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Sump Pump + Battery Backup Cost Calculator',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Cost calculator for sump pumps and battery-backup systems. Primary, combo, water-powered, and smart options compared.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout
  title="Sump Pump + Battery Backup Cost Calculator 2026"
  description="Cost calculator for sump pumps and battery-backup systems. Primary, combo, water-powered, smart WiFi, and generator-circuit options compared."
  active="/sump-pump-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/sump-pump-hero-photo.jpg"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Sump pump calculator', href: '/sump-pump-cost-calculator/' }]}
>
  <section class="container-wide grid gap-6 py-8 md:grid-cols-[minmax(0,1fr)_420px] md:items-center md:py-10">
    <div>
      <p class="eyebrow">Sump pump</p>
      <h1 class="mt-1 text-3xl md:text-4xl">Sump Pump + Battery Backup Calculator</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">Cost calculator for primary sump pumps and battery-backup combo systems. Sized by basement flood risk and outage frequency.</p>
      <p class="mt-3 rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800"><strong>Quick answer:</strong> basic primary 1/3 HP pump $430–$1,030 installed. Combo primary + battery backup $900–$2,500. Smart WiFi combo $1,300–$3,300. Battery backup is the highest-value addition for any finished basement.</p>
    </div>
    <picture>
        <source srcset="/assets/topic-images/sump-pump-hero-photo.avif" type="image/avif" />
        <source srcset="/assets/topic-images/sump-pump-hero-photo.webp" type="image/webp" />
        <img  src="/assets/topic-images/sump-pump-hero-photo.jpg" alt="Sump pump with battery backup in a basement basin"
      width="1200" height="675" class="w-full rounded-lg border border-ink-200 bg-white shadow-card" loading="eager" decoding="async"  />
      </picture>
  </section>

  <section class="container-wide pb-10"><SumpPumpCalculator client:load /></section>

  <section class="container-wide py-8 border-t border-ink-100">
    <div class="max-w-prose">
      <h2 class="text-xl font-semibold text-ink-900">New to sump pumps?</h2>
      <p class="mt-2 text-sm text-ink-700">A sump pump sits in a pit at the lowest point of a basement and ejects water that collects from foundation drains or groundwater. Primary AC pumps run on house power; battery backups run on DC during outages. The capacity that matters most isn&rsquo;t horsepower — it&rsquo;s redundancy. Power loss during a major storm is the most common failure scenario.</p>
      <p class="mt-3 text-sm"><a href="/guides/sump-pumps/" class="font-medium text-brand-700">Read the full guide <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">{faq.map(f => (<details class="card p-4"><summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary><p class="mt-2 text-sm text-ink-700">{f.a}</p></details>))}</div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Related calculators</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
      <li><a href="/generator-cost-calculator/">Generator backup <span aria-hidden="true">→</span></a></li>
      <li><a href="/home-battery-cost-calculator/">Home battery <span aria-hidden="true">→</span></a></li>
      <li><a href="/insulation-cost-calculator/">Insulation (basement) <span aria-hidden="true">→</span></a></li>
      <li><a href="/electrical-panel-upgrade-cost-calculator/">Panel upgrade <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
