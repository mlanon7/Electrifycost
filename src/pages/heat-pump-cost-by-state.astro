---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import {
  ALL_STATES,
  findStateEnergy,
  findStateLabor,
  findClimate,
} from '@/lib/data';

const rows = ALL_STATES.map(s => {
  const energy = findStateEnergy(s.code);
  const labor  = findStateLabor(s.code);
  const climate = findClimate(s.code);
  return {
    code: s.code,
    name: s.name,
    ecents: energy?.electricity_cents_per_kwh ?? 0,
    gas:    energy?.natural_gas_dollars_per_therm ?? 0,
    hvac:   labor?.hvac_multiplier ?? 1,
    zone:   climate?.iecc_zone ?? '—',
    cold:   climate?.heat_pump_class === 'coldclimate',
  };
}).sort((a, b) => a.name.localeCompare(b.name));

const cheapElec = [...rows].sort((a, b) => a.ecents - b.ecents).slice(0, 5);
const expElec   = [...rows].sort((a, b) => b.ecents - a.ecents).slice(0, 5);
const coldStates = rows.filter(r => r.cold);

// Note: the BreadcrumbList schema is emitted by Layout.astro from the
// breadcrumbs prop below — do not hand-code a second one here (duplicate
// identical structured data is a validation warning).
const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Heat Pump Cost by State',
    description: 'Installed-cost estimates, retail electricity prices, climate zones, and HVAC labor multipliers for heat pumps in every U.S. state plus DC.',
  },
];
---
<Layout
  title="Heat Pump Cost by State 2026"
  description="Heat pump installed cost, retail electricity price, labor multiplier, and climate zone for every U.S. state plus DC — ranked and compared."
  active="/heat-pump-cost-calculator/"
  ogImage="/assets/topic-images/heat-pump-hero-photo.jpg"
  schemaJsonLd={schemaJsonLd}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Heat pump cost by state', href: '/heat-pump-cost-by-state/' },
  ]}
>
  <section class="container-wide grid gap-6 py-8 md:grid-cols-[minmax(0,1fr)_420px] md:items-center md:py-10">
    <div>
      <p class="eyebrow">Heat pumps</p>
      <h1 class="mt-1 text-3xl md:text-4xl">Heat Pump Cost by State</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
        Heat pump installed cost varies meaningfully by state. The two biggest drivers are local labor rates (electrician + HVAC mechanic blended) and climate (cold-climate equipment runs higher and longer). Below: 51 state pages each calibrated to local prices and rebates.
      </p>
      <p class="mt-3 rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
        <strong>Quick answer:</strong> typical 3-ton ducted central heat pump installed cost ranges from about $7,500 in low-labor states to $22,000+ in California, New York, and Massachusetts. Climate zone, ductwork condition, and panel size shift the number further. Use the state pages for a calibrated band.
      </p>
    </div>
    <img
      src="/assets/topic-images/heat-pump-hero-photo.webp"
      alt="Outdoor heat pump condenser and indoor air handler shown in a home"
      width="1200" height="675"
      class="w-full rounded-lg border border-ink-200 bg-white shadow-card"
      loading="eager" decoding="async"
    />
  </section>

  <section class="container-wide pb-8">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card p-4">
        <p class="eyebrow">Cheapest electricity (¢/kWh)</p>
        <ul class="mt-2 space-y-1 text-sm text-ink-700">
          {cheapElec.map(s => <li class="flex justify-between"><a href={`/heat-pump-cost-${s.code.toLowerCase()}/`}>{s.name}</a><span class="tabular-nums">{s.ecents.toFixed(1)}¢</span></li>)}
        </ul>
      </div>
      <div class="card p-4">
        <p class="eyebrow">Most expensive electricity</p>
        <ul class="mt-2 space-y-1 text-sm text-ink-700">
          {expElec.map(s => <li class="flex justify-between"><a href={`/heat-pump-cost-${s.code.toLowerCase()}/`}>{s.name}</a><span class="tabular-nums">{s.ecents.toFixed(1)}¢</span></li>)}
        </ul>
      </div>
      <div class="card p-4">
        <p class="eyebrow">Cold-climate states ({coldStates.length})</p>
        <p class="mt-2 text-sm text-ink-700">A NEEP-listed cold-climate or dual-fuel heat pump is the safer pick in these states; equipment costs run higher but operating savings vs. oil and propane are largest.</p>
        <p class="mt-2 text-xs text-ink-600">{coldStates.map(s => s.code).join(' · ')}</p>
      </div>
    </div>
  </section>

  <section class="container-wide pb-10">
    <h2 class="text-xl">All 50 states + DC</h2>
    <p class="mt-2 max-w-prose text-sm text-ink-700">Every state row pulls its own retail electricity price, climate zone, and labor multiplier. Click through for a state-specific calculator and rebate table.</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-600">
          <tr>
            <th class="py-2 pr-3">State</th>
            <th class="py-2 pr-3">Climate</th>
            <th class="py-2 pr-3 tabular-nums">Electricity</th>
            <th class="py-2 pr-3 tabular-nums">Natural gas</th>
            <th class="py-2 pr-3 tabular-nums">HVAC labor</th>
            <th class="py-2 pr-3">Heat-pump class</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr class="border-b border-ink-100">
              <td class="py-2 pr-3">
                <a href={`/heat-pump-cost-${r.code.toLowerCase()}/`} class="font-medium">{r.name}</a>
              </td>
              <td class="py-2 pr-3 text-ink-700">{r.zone}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.ecents.toFixed(1)}¢/kWh</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">${r.gas.toFixed(2)}/therm</td>
              <td class="py-2 pr-3 tabular-nums text-ink-700">{r.hvac.toFixed(2)}×</td>
              <td class="py-2 pr-3">
                {r.cold
                  ? <span class="badge-amber">Cold-climate</span>
                  : <span class="badge-green">Standard</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide pb-12">
    <div class="card p-5">
      <h2 class="text-lg">Next steps</h2>
      <p class="mt-2 max-w-prose text-sm text-ink-700">
        For a planning-range cost calibrated to your home — square footage, current fuel, panel size, ductwork condition — use the <a href="/heat-pump-cost-calculator/" class="text-brand-700 font-medium">heat pump cost calculator</a>. Want a city-level view? See <a href="/heat-pump-cost-by-city/" class="text-brand-700 font-medium">heat pump cost by city</a> for the 100 largest U.S. metros. For deeper background, read the <a href="/guides/heat-pumps/" class="text-brand-700 font-medium">heat pumps guide</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/heat-pump-cost-calculator/" class="btn-primary">Open the calculator <span aria-hidden="true">→</span></a>
        <a href="/heat-pump-cost-by-city/" class="btn-ghost border border-ink-200">Cost by city</a>
        <a href="/guides/heat-pumps/" class="btn-ghost border border-ink-200">Read the guide</a>
      </div>
    </div>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
