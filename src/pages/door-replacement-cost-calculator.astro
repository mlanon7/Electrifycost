---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import DoorReplacementCalculator from '@/components/DoorReplacementCalculator';

const faq = [
  { q: 'How much does it cost to replace a front door?',
    a: 'Steel basic $500–$1,450 installed. Fiberglass mid (most popular — Therma-Tru, Pella, JELD-WEN) $800–$2,300. Premium fiberglass with sidelights $1,500–$3,600. Solid wood $2,000–$5,300. Full pre-hung replacement (frame + door + threshold) adds $300–$800 over slab-only.' },
  { q: 'What about sliding patio doors?',
    a: 'Vinyl 6ft 2-panel basic $1,200–$2,900. Fiberglass premium (Pella, Andersen) $2,600–$6,600. Wood premium (Andersen 400, Marvin) $4,300–$10,700. French double doors $2,500–$6,700. Old single-pane sliders losing seals are the most cost-effective replacement target in older homes.' },
  { q: 'Is there a tax credit for energy-efficient doors?',
    a: 'No, not in 2026. The 25C credit for ENERGY STAR exterior doors (was 30% up to $250 per door, $500 total) expired Dec 31 2025 (OBBBA). Some utility programs in MA, NY, OR still offer $50–$200 rebates on Class A doors but most ended. ENERGY STAR ratings (U-factor ≤ 0.30) still matter for comfort but don&rsquo;t come with a federal subsidy.' },
];

const schemaJsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Door Replacement Cost Calculator',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Cost calculator for front, sliding, French, and garage door replacement. Material tier (steel, fiberglass, wood, vinyl) and state labor adjusted.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout
  title="Door Replacement Cost Calculator 2026"
  description="Cost calculator for door replacement — front, sliding patio, French, and garage doors. Material tier (steel, fiberglass, wood, vinyl) and state adjusted."
  active="/door-replacement-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/door-replacement-hero-photo.jpg"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Door replacement calculator', href: '/door-replacement-cost-calculator/' }]}
>
  <section class="container-wide grid gap-6 py-8 md:grid-cols-[minmax(0,1fr)_420px] md:items-center md:py-10">
    <div>
      <p class="eyebrow">Door replacement</p>
      <h1 class="mt-1 text-3xl md:text-4xl">Door Replacement Cost Calculator</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">Cost calculator for front, sliding patio, French, and garage door replacement. Material tier and state labor adjusted.</p>
      <p class="mt-3 rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800"><strong>Quick answer:</strong> front door — steel $500–$1,450, fiberglass mid $800–$2,300, premium $1,500–$3,600, wood $2,000–$5,300. Sliding patio — vinyl $1,200–$2,900, fiberglass $2,600–$6,600. Garage — steel single $800–$2,200, double $1,300–$3,600.</p>
    </div>
    <picture>
        <source srcset="/assets/topic-images/door-replacement-hero-photo.avif" type="image/avif" />
        <source srcset="/assets/topic-images/door-replacement-hero-photo.webp" type="image/webp" />
        <img  src="/assets/topic-images/door-replacement-hero-photo.webp" alt="New residential entry door installed"
      width="1200" height="675" class="w-full rounded-lg border border-ink-200 bg-white shadow-card" loading="eager" decoding="async"  />
      </picture>
  </section>

  <section class="container-wide pb-10"><DoorReplacementCalculator client:load /></section>

  <section class="container-wide py-8 border-t border-ink-100">
    <div class="max-w-prose">
      <h2 class="text-xl font-semibold text-ink-900">New to door replacement?</h2>
      <p class="mt-2 text-sm text-ink-700">A door replacement is usually a 1-day project but several pieces drive the price: door type (entry, sliding, French, garage), material (steel, fiberglass, wood, vinyl), and whether you need a full pre-hung unit (with frame) or just a slab. Energy savings are modest — 1-3% of HVAC — but the comfort, security, and curb appeal gains are real. Fiberglass entry doors are the modern default for most homeowners.</p>
      <p class="mt-3 text-sm"><a href="/guides/door-replacement/" class="font-medium text-brand-700">Read the full guide →</a></p>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">{faq.map(f => (<details class="card p-4"><summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary><p class="mt-2 text-sm text-ink-700">{f.a}</p></details>))}</div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Related calculators</h2>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
      <li><a href="/window-replacement-cost-calculator/">Window replacement →</a></li>
      <li><a href="/insulation-cost-calculator/">Insulation →</a></li>
      <li><a href="/air-sealing-cost-calculator/">Air sealing →</a></li>
      <li><a href="/home-energy-audit-cost-calculator/">Energy audit →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
