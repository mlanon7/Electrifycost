---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import BatteryCalculator from '@/components/BatteryCalculator';
import { brandsByCategory } from '@/lib/data';

export async function getStaticPaths() {
  return brandsByCategory('battery').map(b => ({ params: { brand: b.slug }, props: { b } }));
}

const { b } = Astro.props as { b: import('@/lib/data').BrandProfile };
const siblings = brandsByCategory('battery').filter(x => x.slug !== b.slug);

const tierVerdict = b.tier === 'premium'
  ? `${b.brand} is a premium battery — you pay more for an integrated, well-supported system.`
  : b.tier === 'value'
  ? `${b.brand} is a value option — lower cost per kWh with solid backup capability.`
  : `${b.brand} is a mid-tier battery — competitive per-kWh pricing with broad installer support.`;

const description = `${b.brand} home battery cost in 2026: installed price per kWh, model lineup, and brand positioning. ${b.positioning}.`;

const faq = [
  {
    q: `How much does a ${b.brand} home battery cost installed?`,
    a: `A ${b.brand} home battery typically runs $1,000 to $1,500 per kWh installed, per NREL benchmark data and 2026 installer quotes. ${b.price_note}. The federal 25D credit that covered 30% of battery cost expired Dec 31 2025 under OBBBA, so 2026 installs pay the full price minus any state or utility incentive. Use the calculator below to size for your needs.`,
  },
  {
    q: `Which ${b.brand} battery model should I look at?`,
    a: `${b.brand}'s residential storage is: ${b.models}. ${b.positioning}. Match the usable capacity (kWh) and continuous power output (kW) to your goal — whole-home backup needs more power than simple bill-shifting. Per NREL, most homes that want meaningful backup land at 10 to 20 kWh.`,
  },
  {
    q: `Is ${b.brand} worth it vs. other battery brands?`,
    a: `${tierVerdict} The biggest cost variables are total capacity and whether you're pairing with new solar (cheaper per kWh) or retrofitting onto an existing system (more expensive). Brand differences in per-kWh price are smaller than the capacity decision itself.`,
  },
  {
    q: `What incentives apply to a ${b.brand} battery in 2026?`,
    a: `The federal 25D residential clean energy credit (30% of battery cost) expired Dec 31 2025 under OBBBA and does not apply to 2026 installs. State and utility storage programs still apply — California SGIP, plus several state and utility resilience and demand-response programs. The calculator below surfaces what's available; verify with the program administrator.`,
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${b.brand} Home Battery Cost`,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  title={`${b.brand} Home Battery Cost 2026 — Price per kWh`}
  description={description}
  active="/home-battery-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
  ogImage="/assets/topic-images/home-battery-hero-photo.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Home battery calculator', href: '/home-battery-cost-calculator/' },
    { name: b.brand, href: `/${b.slug}-home-battery-cost/` },
  ]}
>
  <section class="container-wide py-8 md:py-10">
    <p class="eyebrow">Home battery · {b.brand}</p>
    <h1 class="mt-1 text-3xl md:text-4xl">{b.brand} Home Battery Cost</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-700 md:text-base">
      {b.positioning}. Plan-level installed cost per kWh, model lineup, and where {b.brand} sits among home batteries. The calculator below sizes the estimate to your backup goal.
    </p>
    <p class="mt-3 max-w-2xl rounded-md border border-ink-200 bg-ink-50 p-3 text-sm text-ink-800">
      <strong>Quick answer:</strong> a {b.brand} home battery runs about $1,000-$1,500 per kWh installed. {b.price_note}.
    </p>
  </section>

  <section class="container-wide pb-10"><BatteryCalculator client:load /></section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">Compare other home battery brands</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {siblings.map(s => (
        <li><a href={`/${s.slug}-home-battery-cost/`}>{s.brand} battery cost →</a></li>
      ))}
      <li><a href="/home-battery-cost-calculator/">Main calculator →</a></li>
      <li><a href="/battery-vs-generator/">Battery vs. generator →</a></li>
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
