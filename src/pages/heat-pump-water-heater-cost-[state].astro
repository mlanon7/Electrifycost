---
import Layout from '@/components/Layout.astro';
import AdSlot from '@/components/AdSlot.astro';
import HpwhCalculator from '@/components/HpwhCalculator';
import {
  ALL_STATES,
  findStateEnergy,
  findStateLabor,
  findClimate,
  rebatePrograms,
} from '@/lib/data';
import { fmtUSD } from '@/lib/format';

export async function getStaticPaths() {
  return ALL_STATES.map(s => ({ params: { state: s.code.toLowerCase() } }));
}

const { state: stateParam } = Astro.params as { state: string };
const stateCode = (stateParam ?? '').toUpperCase();
// getStaticPaths enumerates every valid state, so meta is always defined at
// build time. The non-null assertion is safe here.
const meta = ALL_STATES.find(s => s.code === stateCode)!;
const stateName = meta.name;
const energy = findStateEnergy(stateCode);
const labor  = findStateLabor(stateCode);
const climate = findClimate(stateCode);

const stateRebates = rebatePrograms.filter(
  r => (r.module === 'hpwh' || r.module === '') &&
       (r.state === stateCode || r.scope === 'federal')
);

const isCold = climate?.heat_pump_class === 'coldclimate';
const electricityCents = energy?.electricity_cents_per_kwh ?? 0;
const gasPrice = energy?.natural_gas_dollars_per_therm ?? 0;
const oilPrice = energy?.heating_oil_dollars_per_gallon ?? 0;
const propanePrice = energy?.propane_dollars_per_gallon ?? 0;

const blendedMult = ((labor?.hvac_multiplier ?? 1) + (labor?.plumber_multiplier ?? 1)) / 2;
const description = `Estimate the installed cost of a heat pump water heater (HPWH) in ${stateName} (${stateCode}). State HVAC + plumber labor blend ${blendedMult.toFixed(2)}, retail electricity ${electricityCents.toFixed(1)}¢/kWh, ${stateRebates.length} applicable programs.`;

const faq = [
  {
    q: 'How much does a heat pump water heater cost installed?',
    a: 'A 50-gallon 240V hybrid HPWH typically runs $2,200 to $4,200 installed nationally. A 120V plug-in unit runs $1,700 to $3,400. State labor rates and the cost of a new 240V circuit shift the band. Use the calculator above for a state-calibrated estimate.',
  },
  {
    q: 'What rebates apply to HPWHs?',
    a: 'The federal 25C credit expired Dec 31 2025 (OBBBA). DOE HEEHRA provides up to $1,750 for HPWHs in income-qualified households where the state has launched the program. State and utility programs vary; the rebate table above shows what applies in your state.',
  },
  {
    q: 'Where should an HPWH be installed?',
    a: 'HPWHs need about 700 cubic feet of free air space to maintain rated efficiency. A conditioned basement or utility room works well; an unconditioned garage is fine in moderate climates but risky where ambient drops below the unit cutoff temperature.',
  },
];

const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Heat Pump Water Heater Cost Calculator — ${stateName}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title={`Heat Pump Water Heater Cost in ${stateName}`}
  description={description}
  active="/heat-pump-water-heater-cost-calculator/"
  schemaJsonLd={schemaJsonLd}
>
  <section class="container-wide py-8 md:py-10">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{stateName}</p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
      Heat Pump Water Heater Cost in {stateName}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 md:text-base">
      Estimate the installed cost of a hybrid heat pump water heater in {stateName}. Calibrated to local HVAC + plumber labor ({blendedMult.toFixed(2)}× the U.S. average), retail electricity ({electricityCents.toFixed(1)}¢/kWh), and natural-gas price for the operating-cost comparison.
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Labor blend</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{blendedMult.toFixed(2)}×</div>
        <div class="text-xs text-ink-500">HVAC + plumber (BLS)</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Electricity</div>
        <div class="mt-1 text-base font-semibold text-ink-900">{electricityCents.toFixed(1)}¢/kWh</div>
        <div class="text-xs text-ink-500">EIA retail average</div>
      </div>
      <div class="card p-3">
        <div class="text-xs uppercase tracking-wider text-ink-500">Natural gas</div>
        <div class="mt-1 text-base font-semibold text-ink-900">${gasPrice.toFixed(2)}/therm</div>
        <div class="text-xs text-ink-500">vs.-gas comparison</div>
      </div>
    </div>
  </section>

  <section class="container-wide pb-10">
    <HpwhCalculator client:load initialState={stateCode} />
  </section>

  <section class="container-wide py-10">
    <h2 class="text-xl font-semibold text-ink-900">HPWH rebates &amp; credits in {stateName}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink-200 text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="py-2 pr-3">Program</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Amount</th>
            <th class="py-2 pr-3">Expires</th>
          </tr>
        </thead>
        <tbody>
          {stateRebates.map(p => (
            <tr class="border-b border-ink-100 align-top">
              <td class="py-2 pr-3">
                <div class="font-medium text-ink-900">
                  {p.source_url ? <a href={p.source_url} target="_blank" rel="noopener">{p.program_name}</a> : p.program_name}
                </div>
                {p.income_rule === 'income_qualified' && <div class="text-xs text-amber-700">Income-qualified</div>}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.scope === 'federal' ? 'Federal' : p.scope === 'state' ? 'State' : 'Utility'} · {p.incentive_type === 'tax_credit' ? 'Credit' : 'Rebate'}</td>
              <td class="py-2 pr-3 tabular-nums text-ink-900">
                {p.percent > 0 ? `${p.percent}% up to $${p.cap.toLocaleString()}` :
                  p.amount_low === p.amount_high ? `$${p.amount_high.toLocaleString()}` :
                  `$${p.amount_low.toLocaleString()}–$${p.amount_high.toLocaleString()}`}
              </td>
              <td class="py-2 pr-3 text-ink-700">{p.expiration_date || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide py-10 section-shelf section-shelf-soft">
    <h2 class="text-xl font-semibold text-ink-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {faq.map(f => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-medium text-ink-900">{f.q}</summary>
          <p class="mt-2 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-12">
    <h2 class="text-xl font-semibold text-ink-900">HPWH cost by state</h2>
    <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 md:grid-cols-4">
      {ALL_STATES.map(s => (
        <li><a href={`/heat-pump-water-heater-cost-${s.code.toLowerCase()}/`}>{s.name}</a></li>
      ))}
    </ul>
  </section>

  <div class="container-wide"><AdSlot /></div>
</Layout>
