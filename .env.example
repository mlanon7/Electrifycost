# Copy this file to .env.local for local development.
# .env.local is gitignored; never commit secrets.

# EIA Open Data API (https://www.eia.gov/opendata/) — used for live energy prices later.
# Currently unused; the seed CSV ships with the build.
# EIA_API_KEY=

# Plausible / Pirsch — privacy-friendly analytics. Set when ready.
# PLAUSIBLE_DOMAIN=electrifycost.com

# Google AdSense / Mediavine / Raptive — only set once approved.
# AD_NETWORK_ID=
