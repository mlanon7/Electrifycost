# Copy this file to .env.local for local development.
# .env.local is gitignored; never commit secrets.

# ──────────────────────────────────────────────────────────────────────────
# Monetization feature flags
# ──────────────────────────────────────────────────────────────────────────
# Both flags default to 'false'. Set to 'true' to render the corresponding
# components in production. Until flipped on, AdSlot / AffiliateModule /
# AffiliateDisclosure render NOTHING — no third-party scripts load, no
# affiliate links surface.

# Display advertising (Mediavine Journey / AdSense / Raptive). When 'true',
# 140 AdSlot placements across the site render their network-specific ad
# code. Apply via Mediavine onboarding (1,000+ monthly sessions) or AdSense.
# PUBLIC_ADS_ENABLED=false

# Materials affiliate links (Amazon Associates / Lectron / EVBASE). When
# 'true', AffiliateModule renders product cards on EV-charger, HPWH, and
# induction calculator pages; AffiliateDisclosure renders the FTC-required
# disclosure on the same page. Apply to Amazon Associates first; flip the
# flag only after approval.
# PUBLIC_AFFILIATES_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────
# Data sources (not currently wired; the seed CSVs ship with the build)
# ──────────────────────────────────────────────────────────────────────────
# EIA Open Data API (https://www.eia.gov/opendata/) — for live energy prices.
# EIA_API_KEY=

# Plausible / Pirsch — alternative privacy-friendly analytics.
# PLAUSIBLE_DOMAIN=electrifycost.com
